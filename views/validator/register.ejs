<%- include('../partials/head') %>
<body class="<%= tierClass %>">
<%- include('../partials/nav-public') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <div class="section-header">
    <h1>অন-সাইট নিবন্ধন</h1>
    <div style="display:flex;align-items:center;gap:1rem">
      <span style="color:var(--text-muted)"><%= user.name || user.email %></span>
      <form action="/validate/logout" method="POST">
        <button type="submit" class="btn btn-outline" style="font-size:0.85rem;padding:0.3rem 0.8rem">Log Out</button>
      </form>
    </div>
  </div>

  <% if (!event) { %>
    <% if (events.length === 0) { %>
      <div class="empty-state"><p>কোনো সক্রিয় ইভেন্টে নিবন্ধন উন্মুক্ত নেই।</p></div>
    <% } else { %>
      <h2>ইভেন্ট বেছে নিন</h2>
      <div style="display:flex;flex-direction:column;gap:1rem;max-width:480px">
        <% events.forEach(ev => { %>
          <a href="/validate/register/<%= ev.id %>" class="btn btn-outline" style="text-align:left;padding:1rem">
            <strong><%= ev.title %></strong><br>
            <small style="color:var(--text-muted)"><%= new Date(ev.event_date).toLocaleDateString('bn-BD', { timeZone: 'Europe/Berlin' }) %></small>
          </a>
        <% }) %>
      </div>
    <% } %>
  <% } else { %>
    <div class="card" style="max-width:520px;margin-bottom:2rem">
      <h2 style="margin:0 0 0.25rem"><%= event.title %></h2>
      <p style="margin:0;color:var(--text-muted)"><%= new Date(event.event_date).toLocaleString('bn-BD', { timeZone: 'Europe/Berlin' }) %><% if (event.location) { %> &mdash; <%= event.location %><% } %></p>
      <%
        const now = new Date();
        let currentPrice = null, currentTier = null;
        if (event.price_early_bird && event.early_bird_deadline && new Date(event.early_bird_deadline) > now) {
          currentPrice = event.price_early_bird; currentTier = 'হলদে বউ';
        } else if (event.price_mid && event.mid_deadline && new Date(event.mid_deadline) > now) {
          currentPrice = event.price_mid; currentTier = 'নীলকণ্ঠ';
        } else if (event.price_onspot) {
          currentPrice = event.price_onspot; currentTier = 'কোকিলা';
        }
      %>
      <% if (currentPrice) { %>
        <p style="margin:0.5rem 0 0;font-size:0.9rem">বর্তমান মূল্য: <strong>€<%= Number(currentPrice).toFixed(2) %></strong> <span style="color:var(--text-muted)">(<%= currentTier %>)</span></p>
      <% } %>
    </div>

    <form action="/validate/register/<%= event.id %>" method="POST" class="admin-form" style="max-width:520px">
      <div class="form-group">
        <label for="name">নাম *</label>
        <input type="text" id="name" name="name" required placeholder="পূর্ণ নাম">
      </div>
      <div class="form-group">
        <label for="email">ইমেইল</label>
        <input type="email" id="email" name="email" placeholder="email@example.com">
        <small>ইমেইল দিলে QR কোড পাঠানো হবে।</small>
      </div>
      <div class="form-group">
        <label for="phone">ফোন নম্বর *</label>
        <input type="tel" id="phone" name="phone" required placeholder="+49 1XX XXXXXXXX">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="amount">পরিমাণ (€)</label>
          <input type="number" id="amount" name="amount" step="0.01" min="0" value="<%= currentPrice ? Number(currentPrice).toFixed(2) : '' %>" placeholder="0.00">
        </div>
        <div class="form-group">
          <label for="payment_reference">পেমেন্ট রেফারেন্স</label>
          <input type="text" id="payment_reference" name="payment_reference" placeholder="লেনদেন ID বা নাম">
        </div>
      </div>
      <button type="submit" class="btn btn-primary">নিবন্ধন করুন ও QR পাঠান</button>
    </form>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
