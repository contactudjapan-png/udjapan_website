<%- include('../partials/head') %>
<body class="<%= tierClass %>">
<%- include('../partials/nav-public') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <div class="section-header">
    <h1>যন্ত্রপাতি তালিকা</h1>
    <div style="display:flex;align-items:center;gap:1rem">
      <span style="color:var(--text-muted)"><%= user.name || user.email %></span>
      <form action="/validate/logout" method="POST">
        <button type="submit" class="btn btn-outline" style="font-size:0.85rem;padding:0.3rem 0.8rem">Log Out</button>
      </form>
    </div>
  </div>

  <!-- Add instrument form -->
  <div class="card" style="max-width:560px;margin-bottom:2rem">
    <h2 style="margin:0 0 1rem">নতুন যন্ত্র যোগ করুন</h2>
    <form action="/validate/instruments" method="POST" class="admin-form">
      <% if (eventIds && eventIds.length > 1) { %>
      <div class="form-group">
        <label for="event_id">ইভেন্ট *</label>
        <select id="event_id" name="event_id" required>
          <% instruments.reduce((seen, i) => { %>
            <% if (!seen.has(i.event_id)) { seen.add(i.event_id); %>
              <option value="<%= i.event_id %>"><%= i.event_title %></option>
            <% } return seen; %>, new Set()) %>
          </select>
      </div>
      <% } else { %>
        <input type="hidden" name="event_id" value="<%= eventIds[0] %>">
      <% } %>
      <div class="form-group">
        <label for="name">যন্ত্রের নাম *</label>
        <input type="text" id="name" name="name" required placeholder="যেমন: তবলা, সেতার, মাইক্রোফোন...">
      </div>
      <div class="form-group">
        <label for="source">উৎস / কোথা থেকে এসেছে</label>
        <input type="text" id="source" name="source" placeholder="যেমন: ব্যক্তিগত, ভাড়া, স্পনসর নাম...">
      </div>
      <div class="form-group">
        <label for="notes">নোট</label>
        <textarea id="notes" name="notes" rows="2" placeholder="অতিরিক্ত তথ্য..."></textarea>
      </div>
      <button type="submit" class="btn btn-primary">যন্ত্র যোগ করুন</button>
    </form>
  </div>

  <!-- Instruments list -->
  <% if (instruments.length === 0) { %>
    <div class="empty-state"><p>এখনো কোনো যন্ত্র নথিভুক্ত নেই।</p></div>
  <% } else { %>
    <table class="admin-table">
      <thead><tr>
        <th>যন্ত্র</th><th>উৎস</th><th>নোট</th><th>দায়িত্বপ্রাপ্ত</th><th>সময়</th><th></th>
      </tr></thead>
      <tbody>
      <% instruments.forEach(inst => { %>
        <tr>
          <td><strong><%= inst.name %></strong></td>
          <td><%= inst.source || '—' %></td>
          <td><%= inst.notes || '—' %></td>
          <td style="font-size:0.8rem;color:var(--text-muted)"><%= inst.volunteer_email || '—' %></td>
          <td style="font-size:0.8rem;white-space:nowrap"><%= new Date(inst.created_at).toLocaleString('bn-BD', { timeZone: 'Europe/Berlin' }) %></td>
          <td>
            <form action="/validate/instruments/<%= inst.id %>/delete" method="POST" data-confirm="যন্ত্রটি মুছবেন?">
              <button type="submit" class="btn btn-sm btn-danger">মুছুন</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/help-button') %>
</body>
</html>
