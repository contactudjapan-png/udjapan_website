<%- include('../partials/head') %>
<body class="<%= tierClass %>">
<%- include('../partials/nav-public') %>

<main class="container">
  <div class="scanner-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem">
      <h1 style="margin:0">QR যাচাইকারী</h1>
      <form action="/validate/logout" method="POST">
        <button type="submit" class="btn btn-outline" style="font-size:0.85rem;padding:0.3rem 0.8rem">Log Out</button>
      </form>
    </div>
    <p style="color:var(--text-muted);margin-top:0">স্বাগতম, <strong><%= user.name || user.email %></strong></p>
    <p>অ্যাটেন্ডির QR কোড ক্যামেরায় ধরুন বা নিচে টোকেন লিখুন।</p>

    <div id="scanner-container">
      <div id="reader"></div>
    </div>

    <div id="result-box" class="result-box result-box--hidden">
      <div id="result-icon" class="result-icon"></div>
      <div id="result-content"></div>
      <button id="scan-again" class="btn btn-outline">Scan Another</button>
    </div>

    <div id="manual-entry">
      <p class="or-divider">— or enter token manually —</p>
      <form id="manual-form" class="manual-form">
        <input type="text" id="manual-token" placeholder="Paste QR token here" class="manual-input">
        <button type="submit" class="btn btn-outline">Validate</button>
      </form>
    </div>
  </div>
</main>

<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script src="/js/scanner.js"></script>

<%- include('../partials/footer') %>
</body>
</html>
