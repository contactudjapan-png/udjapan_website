<%- include('../partials/head') %>
<body class="<%= tierClass %>">
<%- include('../partials/nav-public') %>

<main class="container">
  <div class="success-card">
    <div class="success-icon">✓</div>
    <h1><%- t('success.confirmed') %></h1>
    <p><%- t('success.thanks') %>, <strong><%= registration.name %></strong>!</p>
    <p><strong><%= event.title %></strong><%- t('success.registered') %></p>

    <div class="qr-section">
      <h2><%- t('success.qr_heading') %></h2>
      <p><%- t('success.qr_show') %> <strong><%= registration.email %></strong><%- t('success.qr_sent') %></p>
      <img src="<%= qrDataUrl %>" alt="QR" class="qr-code-img">
      <p class="qr-hint"><%- t('success.qr_hint') %></p>
    </div>

    <div class="registration-details">
      <h3><%- t('success.details') %></h3>
      <table class="detail-table">
        <tr><td><%- t('success.field_name') %></td><td><%= registration.name %></td></tr>
        <tr><td><%- t('success.field_email') %></td><td><%= registration.email %></td></tr>
        <tr><td><%- t('success.field_event') %></td><td><%= event.title %></td></tr>
        <tr><td><%- t('success.field_date') %></td><td><%= new Date(event.event_date).toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Europe/Berlin' }) %></td></tr>
        <% if (event.location) { %><tr><td><%- t('success.field_place') %></td><td><%= event.location %></td></tr><% } %>
        <tr><td><%- t('success.pay_status') %></td><td><span class="badge <%= registration.is_paid ? 'badge-paid' : 'badge-pending' %>"><%= registration.is_paid ? t('success.paid') : t('success.pending') %></span></td></tr>
        <% if (registration.payment_reference) { %><tr><td><%- t('success.pay_ref') %></td><td><%= registration.payment_reference %></td></tr><% } %>
      </table>
    </div>

    <a href="/" class="btn btn-outline"><%- t('success.back') %></a>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
