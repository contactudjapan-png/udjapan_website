<%- include('../partials/head') %>
<% var _dateLocale = locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-GB' : 'bn-BD'; %>
<body class="home-page <%= tierClass %>">
<%- include('../partials/nav-public') %>
<%- include('../partials/flash') %>

<% const _event = locals.currentEvent || null; %>
<% const _ads = locals.ads || []; %>
<% const _others = locals.otherEvents || []; %>
<% const _announcements = locals.announcements || []; %>

<% if (!_event) { %>
  <main class="container" style="padding:80px 20px;text-align:center">
    <h1 style="color:#888"><%- t('home.coming_soon') %></h1>
    <p style="color:#aaa"><%- t('home.coming_soon_sub') %></p>
  </main>
<% } else { %>

<!-- ── Hero Banner ─────────────────────────────────── -->
<%
  var _bannerUrl = _event.banner_url || null;
  if (tierClass === 'tier-nilkantha' && _event.banner_url_nilkantha) _bannerUrl = _event.banner_url_nilkantha;
  else if (tierClass === 'tier-kokila' && _event.banner_url_kokila) _bannerUrl = _event.banner_url_kokila;
  else if (tierClass === 'tier-bd' && _event.banner_url_bd) _bannerUrl = _event.banner_url_bd;
%>
<section class="home-hero <%= _bannerUrl ? '' : 'home-hero--no-banner' %>">
  <% if (_bannerUrl) { %>
    <img src="<%= _bannerUrl %>" alt="<%= _event.title %>" class="home-hero-img">
  <% } %>
  <div class="home-hero-overlay"></div>
  <div class="home-hero-content">
    <p class="home-hero-label"><%- t('home.upcoming_label') %></p>
    <h1 class="home-hero-title"><%= _event.title %><% if (locals.isLive) { %><span class="live-badge">🔴 <%- t('home.live_now') %></span><% } %></h1>
    <div class="home-hero-meta">
      <span>📅 <%= new Date(_event.event_date).toLocaleDateString(_dateLocale, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Europe/Berlin' }) %></span>
      <% if (_event.location) { %><span>📍 <%= _event.location %></span><% } %>
    </div>
    <% if (_event.registration_open) { %>
      <a href="/event/<%= _event.id %>" class="btn btn-primary btn-hero"><%- t('home.register') %></a>
    <% } else { %>
      <span class="badge badge-closed btn-hero-badge"><%- t('home.reg_closed') %></span>
    <% } %>
    <% if (locals.isLive) { %>
    <div class="hero-live-ctas">
      <a href="/event/<%= _event.id %>/polls" class="btn btn-outline btn-hero-live">📊 <%- t('home.live_polls') %></a>
      <a href="/event/<%= _event.id %>/volunteer" class="btn btn-outline btn-hero-live">🤝 <%- t('home.live_volunteer') %></a>
    </div>
    <% } %>
  </div>
</section>

<!-- ── Body: left panel | main | right panel ───────── -->
<div class="home-body container">

  <% if (_announcements.length > 0 || (locals.activePolls && activePolls.length > 0)) { %>
  <aside class="home-panel" id="annPanel">
    <div class="home-panel-header">
      <h3 class="home-panel-title"><%- t('home.announcements') %></h3>
      <button class="panel-toggle" id="annToggle">−</button>
    </div>
    <div class="home-panel-body" id="annBody">
      <% _announcements.forEach(ann => { %>
        <%
          var _annTitle = ann.title;
          var _annContent = ann.content || '';
          if (locale === 'en') { if (ann.title_en) _annTitle = ann.title_en; if (ann.content_en) _annContent = ann.content_en; }
          else if (locale === 'de') { if (ann.title_de) _annTitle = ann.title_de; if (ann.content_de) _annContent = ann.content_de; }
          var _annContentClean = _annContent ? _annContent.replace(/<p><br\s*\/?><\/p>/gi,'').trim() : '';
        %>
        <% if (ann.link_url) { %><a href="<%= ann.link_url %>" target="_blank" rel="noopener" class="ad-card"><% } else { %><div class="ad-card"><% } %>
          <div class="ad-card-body">
            <strong><%= _annTitle %></strong>
            <% if (_annContentClean) { %><div class="rich-content" style="font-size:0.85rem"><%- _annContentClean %></div><% } %>
            <% if (ann.link_url) { %><span class="ann-link"><%= ann.link_text || ann.link_url %> →</span><% } %>
          </div>
        <% if (ann.link_url) { %></a><% } else { %></div><% } %>
      <% }) %>
      <% if (locals.activePolls && activePolls.length > 0) { %>
        <% activePolls.forEach(function(poll) { %>
          <div class="ad-card" style="margin-top:0.5rem">
            <div class="ad-card-body">
              <strong style="font-size:0.92rem">🗳️ <%= poll.question %></strong>
              <form action="/event/<%= _event.id %>/polls/<%= poll.id %>/vote" method="POST" style="margin-top:0.5rem">
                <div style="margin-bottom:0.4rem">
                  <input type="email" name="voter_email" required placeholder="your@email.com" style="width:100%;padding:0.3rem 0.5rem;font-size:0.82rem;border:1px solid var(--border);border-radius:4px;box-sizing:border-box">
                </div>
                <% const _tot = poll.options.reduce((s,o) => s + (o.vote_count||0), 0); %>
                <% poll.options.forEach(function(opt) { %>
                  <% const _pct = _tot > 0 ? Math.round((opt.vote_count||0) / _tot * 100) : 0; %>
                  <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.84rem;margin-bottom:0.25rem;cursor:pointer">
                    <input type="radio" name="option_id" value="<%= opt.id %>" required>
                    <span><%= opt.option_text %></span>
                    <span style="margin-left:auto;color:var(--text-muted);font-size:0.78rem"><%= opt.vote_count||0 %></span>
                  </label>
                  <div style="height:3px;background:#eee;border-radius:2px;margin-bottom:0.35rem">
                    <div style="height:100%;width:<%= _pct %>%;background:var(--primary);border-radius:2px"></div>
                  </div>
                <% }); %>
                <button type="submit" class="btn btn-primary" style="width:100%;margin-top:0.25rem;font-size:0.85rem;padding:0.35rem">ভোট দিন</button>
              </form>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </aside>
  <% } %>

  <main class="home-main">

    <!-- About -->
    <%
      var _desc = _event.description || '';
      if (locale === 'en' && _event.description_en) _desc = _event.description_en;
      else if (locale === 'de' && _event.description_de) _desc = _event.description_de;
    %>
    <% if (_desc) { %>
    <section class="home-about">
      <h2><%- t('home.about') %></h2>
      <div id="eventDesc" class="rich-content"><%- _desc %></div>
    </section>
    <% } %>

    <% if (_event.early_bird_deadline || _event.mid_deadline || _event.event_date) { %>
    <script>
    (function() {
      var BN = '০১২৩৪৫৬৭৮৯';
      function toBN(n) { return String(n).replace(/[0-9]/g, function(d) { return BN[d]; }); }

      var _loc = '<%= locale %>';
      var _L = {
        bn: { pre: '⏰ শেষ হচ্ছে: ', d: ' দিন', h: ' ঘণ্টা', m: ' মিনিট', s: ' সেকেন্ড', num: toBN },
        en: { pre: '⏰ Ends in: ',   d: ' day', h: ' hr',    m: ' min',    s: ' sec',      num: String },
        de: { pre: '⏰ Endet in: ',  d: ' Tag', h: ' Std',   m: ' Min',    s: ' Sek',      num: String },
      }[_loc] || { pre: '⏰ Ends in: ', d: ' day', h: ' hr', m: ' min', s: ' sec', num: String };

      var eb  = <%- _event.early_bird_deadline ? JSON.stringify(new Date(_event.early_bird_deadline).getTime()) : 'null' %>;
      var mid = <%- _event.mid_deadline        ? JSON.stringify(new Date(_event.mid_deadline).getTime())        : 'null' %>;
      var evd = <%- _event.event_date          ? JSON.stringify(new Date(_event.event_date).getTime())          : 'null' %>;

      var TIERS = [
        { name: 'halide', keywords: [
          'হলদে বউঃ','হলদে বউ:','হলদে বউ',
          'Haldey Bou','Halde Bou','Halide Bou','Holde Bou',
          'Early Bird','Baya Weaver','Yellow Bird'
        ], deadline: eb, start: null },
        { name: 'nilkantha', keywords: [
          'নীলকণ্ঠঃ','নীলকণ্ঠ:','নীলকণ্ঠ',
          'Nilkantha','Nil Kantha','Neelkantha','Neel Kantha',
          'Blue Throat','Indian Roller'
        ], deadline: mid, start: eb },
        { name: 'kokila', keywords: [
          'কোকিলাঃ','কোকিলা:','কোকিলা',
          'Kokila','Koyel','Koyal',
          'Cuckoo','Indian Cuckoo'
        ], deadline: evd, start: mid },
      ];

      function fmt(ms) {
        var n = _L.num;
        var d = Math.floor(ms / 86400000);
        var h = Math.floor((ms % 86400000) / 3600000);
        var m = Math.floor((ms % 3600000) / 60000);
        var s = Math.floor((ms % 60000) / 1000);
        var parts = [];
        if (d > 0) parts.push(n(d) + _L.d);
        if (h > 0) parts.push(n(h) + _L.h);
        if (m > 0 || d > 0) parts.push(n(m) + _L.m);
        parts.push(n(s) + _L.s);
        return parts.join(' ');
      }

      function injectBadges(rootEl) {
        var result = [];
        TIERS.forEach(function(tier) {
          if (!tier.deadline) return;
          var candidates = rootEl.querySelectorAll('p, li, h2, h3, h4, h5, h6, strong, b, td');
          var target = null;
          for (var i = 0; i < candidates.length; i++) {
            var low = candidates[i].textContent.toLowerCase();
            if (tier.keywords.some(function(kw) { return low.indexOf(kw.toLowerCase()) !== -1; })) {
              target = candidates[i]; break;
            }
          }
          if (!target) {
            // fallback: keyword anywhere in root text
            var low = rootEl.textContent.toLowerCase();
            if (tier.keywords.some(function(kw) { return low.indexOf(kw.toLowerCase()) !== -1; })) {
              target = rootEl;
            }
          }
          if (!target) return;
          var br = document.createElement('br');
          var badge = document.createElement('span');
          badge.className = 'tier-badge'; badge.style.display = 'none';
          target.appendChild(br); target.appendChild(badge);
          result.push({ el: badge, deadline: tier.deadline, start: tier.start, name: tier.name });
        });
        return result;
      }

      var badges = [];
      var descEl = document.getElementById('eventDesc');
      if (descEl) badges = badges.concat(injectBadges(descEl));
      if (!badges.length) return;

      function tick() {
        var now = Date.now();
        badges.forEach(function(b) {
          var active = b.deadline && now < b.deadline && (!b.start || now >= b.start);
          if (!active) { b.el.style.display = 'none'; return; }
          b.el.style.display = 'inline-block';
          var rem = b.deadline - now;
          var urgency = rem < 6 * 3600000  ? 'urgent'  :
                        rem < 24 * 3600000 ? 'warning' :
                        rem < 3 * 86400000 ? 'soon'    : 'normal';
          b.el.className = 'tier-badge tier-badge--' + b.name + ' tier-badge--' + urgency;
          b.el.textContent = _L.pre + fmt(rem);
        });
      }

      tick();
      setInterval(tick, 1000);
    })();
    </script>
    <% } %>

    <!-- Other Events -->
    <% if (_others.length > 0) { %>
    <section class="home-other-events">
      <h2><%- t('home.other_events') %></h2>
      <div class="events-grid">
        <% _others.forEach(ev => { %>
          <a href="/event/<%= ev.id %>" class="event-card">
            <% if (ev.banner_url) { %>
              <div class="event-card-banner" style="background-image: url('<%= ev.banner_url %>')"></div>
            <% } else { %>
              <div class="event-card-banner event-card-banner--placeholder"></div>
            <% } %>
            <div class="event-card-body">
              <h2><%= ev.title %></h2>
              <p class="event-meta">📅 <%= new Date(ev.event_date).toLocaleDateString(_dateLocale, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Europe/Berlin' }) %></p>
              <% if (ev.location) { %><p class="event-meta">📍 <%= ev.location %></p><% } %>
              <% if (!ev.registration_open) { %>
                <span class="badge badge-closed"><%- t('home.reg_closed') %></span>
              <% } else { %>
                <span class="badge badge-open"><%- t('home.reg_open') %></span>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
    <% } %>

  </main>

  <% if (_ads.length > 0) { %>
  <aside class="home-panel" id="adPanel">
    <div class="home-panel-header">
      <h3 class="home-panel-title"><%- t('home.sponsors') %></h3>
      <button class="panel-toggle" id="adToggle">−</button>
    </div>
    <div class="home-panel-body" id="adBody">
      <% _ads.forEach(ad => { %>
        <% if (ad.link_url) { %>
          <a href="<%= ad.link_url %>" target="_blank" rel="noopener" class="ad-card">
        <% } else { %>
          <div class="ad-card">
        <% } %>
          <% if (ad.image_url) { %>
            <img src="<%= ad.image_url %>" alt="<%= ad.title %>" class="ad-card-img">
          <% } else { %>
            <div class="ad-card-placeholder"><%- t('home.ad_placeholder') %></div>
          <% } %>
          <div class="ad-card-body">
            <%
              var _adTitle = ad.title;
              var _adDesc = ad.description || '';
              if (locale === 'en') { if (ad.title_en) _adTitle = ad.title_en; if (ad.description_en) _adDesc = ad.description_en; }
              else if (locale === 'de') { if (ad.title_de) _adTitle = ad.title_de; if (ad.description_de) _adDesc = ad.description_de; }
              var _adDescPub = _adDesc ? _adDesc.replace(/<p><br\s*\/?><\/p>/gi,'').trim() : '';
            %>
            <strong><%= _adTitle %></strong>
            <% if (_adDescPub) { %><div><%- _adDescPub %></div><% } %>
          </div>
        <% if (ad.link_url) { %></a><% } else { %></div><% } %>
      <% }) %>
    </div>
  </aside>
  <% } %>

</div>

<script>
(function() {
  function initToggle(panelId, toggleId, bodyId, key) {
    var panel = document.getElementById(panelId);
    var toggle = document.getElementById(toggleId);
    var body = document.getElementById(bodyId);
    if (!panel) return;
    function setMin(min) {
      body.style.display = min ? 'none' : '';
      toggle.textContent = min ? '+' : '−';
      localStorage.setItem(key, min ? '1' : '0');
    }
    toggle.addEventListener('click', function() { setMin(body.style.display !== 'none'); });
    if (localStorage.getItem(key) === '1') setMin(true);
  }
  initToggle('annPanel', 'annToggle', 'annBody', 'annMin');
  initToggle('adPanel', 'adToggle', 'adBody', 'adMin');
})();
</script>

<% } %>

<% if (_event && _event.popup_image_url) { %>
<div class="popup-overlay" id="popupOverlay">
  <div class="popup-modal">
    <button class="popup-close" id="popupClose" aria-label="বন্ধ করুন">✕</button>
    <img src="<%= _event.popup_image_url %>" alt="<%= _event.title %>" class="popup-img">
    <% if (_event.registration_open) { %>
      <a href="/event/<%= _event.id %>" class="btn btn-primary popup-cta"><%- t('home.register') %></a>
    <% } %>
  </div>
</div>
<script>
(function() {
  var overlay = document.getElementById('popupOverlay');
  overlay.style.display = 'flex';
  function close() { overlay.style.display = 'none'; }
  document.getElementById('popupClose').addEventListener('click', close);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });
})();
</script>
<% } %>

<%- include('../partials/footer') %>
</body>
</html>
