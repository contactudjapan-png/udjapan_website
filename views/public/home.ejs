<%- include('../partials/head') %>
<%
  var _nowTs = Date.now();
  var _ebTs  = locals.currentEvent && locals.currentEvent.early_bird_deadline ? new Date(locals.currentEvent.early_bird_deadline).getTime() : null;
  var _midTs = locals.currentEvent && locals.currentEvent.mid_deadline        ? new Date(locals.currentEvent.mid_deadline).getTime()        : null;
  var _evdTs = locals.currentEvent && locals.currentEvent.event_date          ? new Date(locals.currentEvent.event_date).getTime()          : null;
  var _tierCls = 'tier-bd';
  if (_ebTs  && _nowTs < _ebTs)  _tierCls = 'tier-halide';
  else if (_midTs && _nowTs < _midTs && (!_ebTs  || _nowTs >= _ebTs))  _tierCls = 'tier-nilkantha';
  else if (_evdTs && _nowTs < _evdTs && (!_midTs || _nowTs >= _midTs)) _tierCls = 'tier-kokila';
%>
<body class="home-page <%= _tierCls %>">
<%- include('../partials/nav-public') %>
<%- include('../partials/flash') %>

<% const _event = locals.currentEvent || null; %>
<% const _ads = locals.ads || []; %>
<% const _others = locals.otherEvents || []; %>
<% const _announcements = locals.announcements || []; %>

<% if (!_event) { %>
  <main class="container" style="padding:80px 20px;text-align:center">
    <h1 style="color:#888"><%- t('home.coming_soon') %></h1>
    <p style="color:#aaa"><%- t('home.coming_soon_sub') %></p>
  </main>
<% } else { %>

<!-- ── Hero Banner ─────────────────────────────────── -->
<section class="home-hero <%= _event.banner_url ? '' : 'home-hero--no-banner' %>">
  <% if (_event.banner_url) { %>
    <img src="<%= _event.banner_url %>" alt="<%= _event.title %>" class="home-hero-img">
  <% } %>
  <div class="home-hero-overlay"></div>
  <div class="home-hero-content">
    <p class="home-hero-label"><%- t('home.upcoming_label') %></p>
    <h1 class="home-hero-title"><%= _event.title %></h1>
    <div class="home-hero-meta">
      <span>📅 <%= new Date(_event.event_date).toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Europe/Berlin' }) %></span>
      <% if (_event.location) { %><span>📍 <%= _event.location %></span><% } %>
    </div>
    <% if (_event.registration_open) { %>
      <a href="/event/<%= _event.id %>" class="btn btn-primary btn-hero"><%- t('home.register') %></a>
    <% } else { %>
      <span class="badge badge-closed btn-hero-badge"><%- t('home.reg_closed') %></span>
    <% } %>
  </div>
</section>

<!-- ── Body: left panel | main | right panel ───────── -->
<div class="home-body container">

  <% if (_announcements.length > 0) { %>
  <aside class="home-panel" id="annPanel">
    <div class="home-panel-header">
      <h3 class="home-panel-title"><%- t('home.announcements') %></h3>
      <button class="panel-toggle" id="annToggle">−</button>
    </div>
    <div class="home-panel-body" id="annBody">
      <% _announcements.forEach(ann => { %>
        <div class="announcement-item">
          <strong><%= ann.title %></strong>
          <div><%- ann.content.replace(/\n/g, '<br>') %></div>
        </div>
      <% }) %>
    </div>
  </aside>
  <% } %>

  <main class="home-main">

    <!-- About -->
    <% if (_event.description) { %>
    <section class="home-about">
      <h2><%- t('home.about') %></h2>
      <div id="eventDesc" class="rich-content"><%- _event.description %></div>
    </section>
    <% } %>

    <% if (_event.early_bird_deadline || _event.mid_deadline || _event.event_date) { %>
    <script>
    (function() {
      var BN = '০১২৩৪৫৬৭৮৯';
      function toBN(n) {
        return String(n).replace(/[0-9]/g, function(d) { return BN[d]; });
      }

      var eb  = <%- _event.early_bird_deadline ? JSON.stringify(new Date(_event.early_bird_deadline).getTime()) : 'null' %>;
      var mid = <%- _event.mid_deadline        ? JSON.stringify(new Date(_event.mid_deadline).getTime())        : 'null' %>;
      var evd = <%- _event.event_date          ? JSON.stringify(new Date(_event.event_date).getTime())          : 'null' %>;

      var TIERS = [
        { name: 'halide',     keywords: ['হলদে বউঃ','হলদে বউ:'], deadline: eb,  start: null },
        { name: 'nilkantha',  keywords: ['নীলকণ্ঠঃ','নীলকণ্ঠ:'],  deadline: mid, start: eb   },
        { name: 'kokila',     keywords: ['কোকিলাঃ','কোকিলা:'],   deadline: evd, start: mid  },
      ];

      function isActive(tier, now) {
        if (!tier.deadline) return false;
        if (now >= tier.deadline) return false;        // expired
        if (tier.start && now < tier.start) return false; // not started yet
        return true;
      }

      function fmt(ms) {
        var d = Math.floor(ms / 86400000);
        var h = Math.floor((ms % 86400000) / 3600000);
        var m = Math.floor((ms % 3600000) / 60000);
        var s = Math.floor((ms % 60000) / 1000);
        var parts = [];
        if (d > 0) parts.push(toBN(d) + ' দিন');
        if (h > 0) parts.push(toBN(h) + ' ঘণ্টা');
        if (m > 0 || d > 0) parts.push(toBN(m) + ' মিনিট');
        parts.push(toBN(s) + ' সেকেন্ড');
        return parts.join(' ');
      }

      var descEl = document.getElementById('eventDesc');
      if (!descEl) return;

      var badges = [];
      TIERS.forEach(function(tier) {
        if (!tier.deadline) return;
        var strongs = descEl.querySelectorAll('strong, b');
        for (var i = 0; i < strongs.length; i++) {
          var txt = strongs[i].textContent;
          var matched = tier.keywords.some(function(kw) { return txt.indexOf(kw) !== -1; });
          if (matched) {
            var badge = document.createElement('span');
            badge.className = 'tier-badge';
            badge.style.display = 'none';
            strongs[i].parentNode.insertBefore(badge, strongs[i].nextSibling);
            badges.push({ el: badge, deadline: tier.deadline, start: tier.start, name: tier.name });
            break;
          }
        }
      });

      function tick() {
        var now = Date.now();
        badges.forEach(function(b) {
          var active = b.deadline && now < b.deadline && (!b.start || now >= b.start);
          if (!active) { b.el.style.display = 'none'; return; }

          b.el.style.display = 'inline-block';
          var rem = b.deadline - now;
          var urgency = rem < 6 * 3600000  ? 'urgent'  :
                        rem < 24 * 3600000 ? 'warning' :
                        rem < 3 * 86400000 ? 'soon'    : 'normal';
          b.el.className = 'tier-badge tier-badge--' + b.name + ' tier-badge--' + urgency;
          b.el.textContent = '⏰ শেষ হচ্ছে: ' + fmt(rem);
        });
      }

      tick();
      setInterval(tick, 1000);
    })();
    </script>
    <% } %>

    <!-- Other Events -->
    <% if (_others.length > 0) { %>
    <section class="home-other-events">
      <h2><%- t('home.other_events') %></h2>
      <div class="events-grid">
        <% _others.forEach(ev => { %>
          <a href="/event/<%= ev.id %>" class="event-card">
            <% if (ev.banner_url) { %>
              <div class="event-card-banner" style="background-image: url('<%= ev.banner_url %>')"></div>
            <% } else { %>
              <div class="event-card-banner event-card-banner--placeholder"></div>
            <% } %>
            <div class="event-card-body">
              <h2><%= ev.title %></h2>
              <p class="event-meta">📅 <%= new Date(ev.event_date).toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Europe/Berlin' }) %></p>
              <% if (ev.location) { %><p class="event-meta">📍 <%= ev.location %></p><% } %>
              <% if (!ev.registration_open) { %>
                <span class="badge badge-closed"><%- t('home.reg_closed') %></span>
              <% } else { %>
                <span class="badge badge-open"><%- t('home.reg_open') %></span>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
    <% } %>

  </main>

  <% if (_ads.length > 0) { %>
  <aside class="home-panel" id="adPanel">
    <div class="home-panel-header">
      <h3 class="home-panel-title"><%- t('home.sponsors') %></h3>
      <button class="panel-toggle" id="adToggle">−</button>
    </div>
    <div class="home-panel-body" id="adBody">
      <% _ads.forEach(ad => { %>
        <% if (ad.link_url) { %>
          <a href="<%= ad.link_url %>" target="_blank" rel="noopener" class="ad-card">
        <% } else { %>
          <div class="ad-card">
        <% } %>
          <% if (ad.image_url) { %>
            <img src="<%= ad.image_url %>" alt="<%= ad.title %>" class="ad-card-img">
          <% } else { %>
            <div class="ad-card-placeholder"><%- t('home.ad_placeholder') %></div>
          <% } %>
          <div class="ad-card-body">
            <strong><%= ad.title %></strong>
            <% const _adDescPub = ad.description ? ad.description.replace(/<p><br\s*\/?><\/p>/gi,'').trim() : ''; %>
            <% if (_adDescPub) { %><div><%- _adDescPub %></div><% } %>
          </div>
        <% if (ad.link_url) { %></a><% } else { %></div><% } %>
      <% }) %>
    </div>
  </aside>
  <% } %>

</div>

<script>
(function() {
  function initToggle(panelId, toggleId, bodyId, key) {
    var panel = document.getElementById(panelId);
    var toggle = document.getElementById(toggleId);
    var body = document.getElementById(bodyId);
    if (!panel) return;
    function setMin(min) {
      body.style.display = min ? 'none' : '';
      toggle.textContent = min ? '+' : '−';
      localStorage.setItem(key, min ? '1' : '0');
    }
    toggle.addEventListener('click', function() { setMin(body.style.display !== 'none'); });
    if (localStorage.getItem(key) === '1') setMin(true);
  }
  initToggle('annPanel', 'annToggle', 'annBody', 'annMin');
  initToggle('adPanel', 'adToggle', 'adBody', 'adMin');
})();
</script>

<% } %>

<% if (_event && _event.popup_image_url) { %>
<div class="popup-overlay" id="popupOverlay">
  <div class="popup-modal">
    <button class="popup-close" id="popupClose" aria-label="বন্ধ করুন">✕</button>
    <img src="<%= _event.popup_image_url %>" alt="<%= _event.title %>" class="popup-img">
    <% if (_event.registration_open) { %>
      <a href="/event/<%= _event.id %>" class="btn btn-primary popup-cta"><%- t('home.register') %></a>
    <% } %>
  </div>
</div>
<script>
(function() {
  var overlay = document.getElementById('popupOverlay');
  overlay.style.display = 'flex';
  function close() { overlay.style.display = 'none'; }
  document.getElementById('popupClose').addEventListener('click', close);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });
})();
</script>
<% } %>

<%- include('../partials/footer') %>
</body>
</html>
