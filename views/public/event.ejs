<%- include('../partials/head') %>
<body class="event-page"<% if (event.banner_url) { %> style="background-image:url('<%= event.banner_url %>');background-attachment:fixed;background-position:top center;background-size:100% auto;background-repeat:no-repeat"<% } %>>
<div class="event-overlay">
<%- include('../partials/nav-public') %>
<%- include('../partials/flash') %>

<main class="container">

  <!-- ── Slim event header ───────────────────────────── -->
  <div class="event-detail-card">
    <% if (event.banner_url) { %>
      <img src="<%= event.banner_url %>" alt="<%= event.title %>" style="width:100%;max-height:320px;object-fit:cover;border-radius:var(--radius);margin-bottom:1rem;">
    <% } %>
    <h1 style="margin-bottom:0.5rem"><%= event.title %></h1>
    <p style="color:var(--text-muted);margin:0"><%= new Date(event.event_date).toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Berlin' }) %></p>
    <% if (event.location) { %><p style="color:var(--text-muted);margin:0.25rem 0 0">📍 <%= event.location %></p><% } %>
  </div>

  <!-- ── Payment & Registration ─────────────────────── -->
  <% if (event.registration_open) { %>
  <div class="event-detail-card" style="margin-top:1.5rem">
    <h2 style="margin-top:0">পেমেন্ট তথ্য জমা দিন</h2>
    <p class="section-hint">জমা দেওয়ার পরে, অ্যাডমিন আপনার পেমেন্ট যাচাই করবেন এবং ইমেইলে আপনার প্রবেশ QR কোড পাঠাবেন।</p>

    <% if (event.payment_description) { %>
      <div style="margin-bottom:1.25rem;padding:1rem;background:var(--bg);border-radius:var(--radius);line-height:1.8">
        <%- event.payment_description.replace(/\n/g, '<br>') %>
      </div>
    <% } %>

    <%
      const now = new Date();
      const eventDate = new Date(event.event_date);
      let activeTier = null;
      let activeTierLabel = null;
      let activePrice = null;
      if (event.price_early_bird && event.early_bird_deadline && now <= new Date(event.early_bird_deadline)) {
        activeTier = 'early_bird';
        activeTierLabel = 'হলদে বউ';
        activePrice = event.price_early_bird;
      } else if (event.price_mid && now <= new Date(eventDate.getTime() - 60 * 60 * 1000)) {
        activeTier = 'mid';
        activeTierLabel = 'নীলকণ্ঠ';
        activePrice = event.price_mid;
      } else if (event.price_onspot) {
        activeTier = 'onspot';
        activeTierLabel = 'কোকিলা';
        activePrice = event.price_onspot;
      }
    %>
    <% if (activeTier && activePrice) { %>
      <div class="ticket-price-banner">
        <span class="ticket-tier-label"><%= activeTierLabel %></span>
        <span class="ticket-price">€<%= parseFloat(activePrice).toFixed(2) %></span>
      </div>
      <% if (activeTier === 'early_bird' && event.early_bird_deadline) { %>
        <p class="ticket-deadline">হলদে বউ শেষ: <strong><%= new Date(event.early_bird_deadline).toLocaleDateString('bn-BD', {month:'long',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Europe/Berlin'}) %></strong></p>
      <% } else if (activeTier === 'mid' && event.mid_deadline) { %>
        <p class="ticket-deadline">নীলকণ্ঠ মূল্য শেষ: <strong><%= new Date(event.mid_deadline).toLocaleDateString('bn-BD', {month:'long',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Europe/Berlin'}) %></strong></p>
      <% } %>
    <% } else if (event.price_early_bird || event.price_mid || event.price_onspot) { %>
      <div class="ticket-tiers">
        <% if (event.price_early_bird) { %><div class="tier-row"><span>হলদে বউ</span><span>€<%= parseFloat(event.price_early_bird).toFixed(2) %></span><% if(event.early_bird_deadline){%><small>পর্যন্ত <%= new Date(event.early_bird_deadline).toLocaleDateString('bn-BD', { timeZone: 'Europe/Berlin' }) %></small><%}%></div><% } %>
        <% if (event.price_mid) { %><div class="tier-row"><span>নীলকণ্ঠ</span><span>€<%= parseFloat(event.price_mid).toFixed(2) %></span><% if(event.mid_deadline){%><small>পর্যন্ত <%= new Date(event.mid_deadline).toLocaleDateString('bn-BD', { timeZone: 'Europe/Berlin' }) %></small><%}%></div><% } %>
        <% if (event.price_onspot) { %><div class="tier-row"><span>কোকিলা</span><span>€<%= parseFloat(event.price_onspot).toFixed(2) %></span></div><% } %>
      </div>
    <% } %>

    <div class="paypal-section">
      <h3>ধাপ ১: PayPal-এ পেমেন্ট করুন</h3>
      <% if (event.paypal_qr_url) { %>
        <p>প্রথমে নিচের QR কোডটি স্ক্যান করে PayPal পেমেন্ট সম্পন্ন করুন।</p>
        <img src="<%= event.paypal_qr_url %>" alt="PayPal QR কোড" class="paypal-qr-img">
      <% } else { %>
        <div class="paypal-placeholder">
          <p>PayPal পেমেন্ট QR এখানে প্রদর্শিত হবে। পেমেন্ট বিবরণের জন্য আয়োজকের সাথে যোগাযোগ করুন।</p>
        </div>
      <% } %>
    </div>

    <h3>ধাপ ২: আপনার তথ্য জমা দিন</h3>
    <form action="/event/<%= event.id %>/register" method="POST" class="register-form">
      <% if (activeTier) { %>
        <input type="hidden" name="ticket_type" value="<%= activeTier %>">
        <input type="hidden" name="ticket_price" value="<%= activePrice %>">
      <% } %>
      <div class="form-group">
        <label for="name">অংশগ্রহণকারীর/অংশগ্রহণকারীদের নাম *</label>
        <input type="text" id="name" name="name" required placeholder="নাম">
        <small>একাধিক নাম হলে "/" বা কমা দিয়ে আলাদা করুন</small>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="children_count">অনূর্ধ্ব-১৫ বছর বয়সী অংশগ্রহণকারীর সংখ্যা *</label>
          <input type="number" id="children_count" name="children_count" required min="0" value="0">
        </div>
        <div class="form-group">
          <label for="adults_count">১৫ বছর বা তদূর্ধ্ব অংশগ্রহণকারীর সংখ্যা *</label>
          <input type="number" id="adults_count" name="adults_count" required min="0" value="0">
        </div>
      </div>
      <div class="form-group">
        <label for="payment_reference">পেপাল ট্রানজেকশন নম্বর / ব্যাংক ট্রান্সফারকারীর নাম *</label>
        <input type="text" id="payment_reference" name="payment_reference" required placeholder="লেনদেন আইডি বা নাম">
      </div>
      <div class="form-group">
        <label for="email">ইমেইল, ইমেইল যদি না থাকে তবে টেলিফোন নম্বর *</label>
        <input type="text" id="email" name="email" required placeholder="your@email.com অথবা +49...">
      </div>
      <button type="submit" class="btn btn-primary">জমা দিন</button>
    </form>
  </div>
  <% } else { %>
  <div class="event-detail-card" style="margin-top:1.5rem">
    <div class="registration-closed">
      <p>এই ইভেন্টের জন্য সাবমিশন বর্তমানে বন্ধ।</p>
    </div>
  </div>
  <% } %>

</main>

<%- include('../partials/footer') %>
</div>
</body>
</html>
