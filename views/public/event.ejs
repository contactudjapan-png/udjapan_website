<%- include('../partials/head') %>
<% var _dateLocale = locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-GB' : 'bn-BD'; %>
<body class="event-page <%= tierClass %>"<% if (event.banner_url) { %> style="background-image:url('<%= event.banner_url %>');background-attachment:fixed;background-position:top center;background-size:100% auto;background-repeat:no-repeat"<% } %>>
<div class="event-overlay">
<%- include('../partials/nav-public') %>
<%- include('../partials/flash') %>

<main class="container">

  <!-- ── Slim event header ───────────────────────────── -->
  <div class="event-detail-card">
    <% if (event.banner_url) { %>
      <img src="<%= event.banner_url %>" alt="<%= event.title %>" style="width:100%;max-height:320px;object-fit:cover;border-radius:var(--radius);margin-bottom:1rem;">
    <% } %>
    <h1 style="margin-bottom:0.5rem"><%= event.title %></h1>
    <p style="color:var(--text-muted);margin:0"><%= new Date(event.event_date).toLocaleDateString(_dateLocale, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Berlin' }) %></p>
    <% if (event.location) { %><p style="color:var(--text-muted);margin:0.25rem 0 0">📍 <%= event.location %></p><% } %>
  </div>

  <!-- ── Payment & Registration ─────────────────────── -->
  <% if (event.registration_open) { %>
  <div class="event-detail-card" style="margin-top:1.5rem">
    <h2 style="margin-top:0"><%- t('event.payment_heading') %></h2>
    <p class="section-hint"><%- t('event.payment_hint') %></p>

    <%
      var _payDesc = event.payment_description || '';
      if (locale === 'en' && event.payment_description_en) _payDesc = event.payment_description_en;
      else if (locale === 'de' && event.payment_description_de) _payDesc = event.payment_description_de;

      const now = new Date();
      const eventDate = new Date(event.event_date);
      let activeTier = null;
      let activeTierLabel = null;
      let activePrice = null;
      if (event.price_early_bird && event.early_bird_deadline && now <= new Date(event.early_bird_deadline)) {
        activeTier = 'early_bird';
        activeTierLabel = t('event.tier_early');
        activePrice = event.price_early_bird;
      } else if (event.price_mid && now <= new Date(eventDate.getTime() - 60 * 60 * 1000)) {
        activeTier = 'mid';
        activeTierLabel = t('event.tier_mid');
        activePrice = event.price_mid;
      } else if (event.price_onspot) {
        activeTier = 'onspot';
        activeTierLabel = t('event.tier_onspot');
        activePrice = event.price_onspot;
      }
    %>

    <div class="event-reg-layout">

      <!-- Left: payment info -->
      <div class="event-reg-left">
        <% if (_payDesc) { %>
          <div class="pay-desc-box" id="payDescBox"><%- _payDesc.replace(/\n/g, '<br>') %></div>
        <% } %>

        <% if (activeTier && activePrice) { %>
          <div class="ticket-price-banner">
            <span class="ticket-tier-label"><%= activeTierLabel %></span>
            <span class="ticket-price">€<%= parseFloat(activePrice).toFixed(2) %></span>
          </div>
          <% if (activeTier === 'early_bird' && event.early_bird_deadline) { %>
            <p class="ticket-deadline"><%- t('event.early_ends') %> <strong><%= new Date(event.early_bird_deadline).toLocaleDateString(_dateLocale, {month:'long',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Europe/Berlin'}) %></strong></p>
            <p id="tierCountdown" class="tier-countdown"></p>
          <% } else if (activeTier === 'mid' && event.mid_deadline) { %>
            <p class="ticket-deadline"><%- t('event.mid_ends') %> <strong><%= new Date(event.mid_deadline).toLocaleDateString(_dateLocale, {month:'long',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Europe/Berlin'}) %></strong></p>
            <p id="tierCountdown" class="tier-countdown"></p>
          <% } %>
        <a href="/event/<%= event.id %>/volunteer" class="btn btn-outline" style="margin-top:0.75rem;display:inline-block"><%- t('event.volunteer_btn') %></a>
        <% } else if (event.price_early_bird || event.price_mid || event.price_onspot) { %>
          <div class="ticket-tiers">
            <% if (event.price_early_bird) { %><div class="tier-row"><span><%- t('event.tier_early') %></span><span>€<%= parseFloat(event.price_early_bird).toFixed(2) %></span><% if(event.early_bird_deadline){%><small><%- t('event.until') %> <%= new Date(event.early_bird_deadline).toLocaleDateString(_dateLocale, { timeZone: 'Europe/Berlin' }) %></small><%}%></div><% } %>
            <% if (event.price_mid) { %><div class="tier-row"><span><%- t('event.tier_mid') %></span><span>€<%= parseFloat(event.price_mid).toFixed(2) %></span><% if(event.mid_deadline){%><small><%- t('event.until') %> <%= new Date(event.mid_deadline).toLocaleDateString(_dateLocale, { timeZone: 'Europe/Berlin' }) %></small><%}%></div><% } %>
            <% if (event.price_onspot) { %><div class="tier-row"><span><%- t('event.tier_onspot') %></span><span>€<%= parseFloat(event.price_onspot).toFixed(2) %></span></div><% } %>
          </div>
        <% } %>
      </div>

      <!-- Right: steps -->
      <div class="event-reg-right">
        <div class="paypal-section">
          <h3><%- t('event.step1') %></h3>
          <% if (event.paypal_qr_url) { %>
            <p><%- t('event.scan_qr') %></p>
            <img src="<%= event.paypal_qr_url %>" alt="PayPal QR" class="paypal-qr-img">
          <% } else { %>
            <div class="paypal-placeholder">
              <p><%- t('event.paypal_contact') %></p>
            </div>
          <% } %>
          <p class="paypal-ff-warn"><%- t('event.paypal_ff_warn') %></p>
        </div>

        <h3><%- t('event.step2') %></h3>
        <form action="/event/<%= event.id %>/register" method="POST" class="register-form">
          <% if (activeTier) { %>
            <input type="hidden" name="ticket_type" value="<%= activeTier %>">
            <input type="hidden" name="ticket_price" value="<%= activePrice %>">
          <% } %>
          <div class="form-group">
            <label for="name"><%- t('event.field_name') %></label>
            <input type="text" id="name" name="name" required placeholder="<%- t('event.field_name_ph') %>">
            <small><%- t('event.field_name_hint') %></small>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="adults_count"><%- t('event.field_adults') %></label>
              <input type="number" id="adults_count" name="adults_count" required min="0" value="1">
            </div>
            <div class="form-group">
              <label for="children_count"><%- t('event.field_children') %></label>
              <input type="number" id="children_count" name="children_count" required min="0" value="0">
            </div>
          </div>
          <% if (activeTier && activePrice) { %>
          <div class="ticket-price-banner" id="totalPriceBanner" style="margin-bottom:1rem">
            <span class="ticket-tier-label" id="totalPriceTier"><%= activeTierLabel %></span>
            <span class="ticket-price" id="totalPriceValue">€<%= parseFloat(activePrice).toFixed(2) %></span>
          </div>
          <p id="totalPriceHint" style="font-size:0.85rem;color:var(--text-muted);margin-top:-0.5rem;margin-bottom:0.75rem"></p>
          <% } %>
          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" name="is_special_needs" value="true">
              <%- t('reg.special_needs') %>
            </label>
          </div>
          <div class="form-group">
            <label for="payment_reference"><%- t('event.field_pay_ref') %></label>
            <input type="text" id="payment_reference" name="payment_reference" required placeholder="<%- t('event.field_pay_ref_ph') %>">
          </div>
          <div class="contact-either-hint"><%- t('event.contact_either') %></div>
          <div class="form-group">
            <label for="email"><%- t('event.field_contact') %></label>
            <input type="email" id="email" name="email" placeholder="<%- t('event.field_contact_ph') %>" autocomplete="email">
          </div>
          <div class="form-group">
            <label for="phone"><%- t('event.field_phone') %></label>
            <input type="tel" id="phone" name="phone" placeholder="+49 1XX XXXXXXXX" autocomplete="tel">
          </div>
          <p id="contactError" class="contact-error" style="display:none"><%- t('event.contact_err') %></p>
          <div class="form-group">
            <label><%- t('event.payment_method') %></label>
            <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.25rem">
              <label style="display:flex;align-items:center;gap:0.4rem;cursor:pointer">
                <input type="radio" name="payment_method" value="paypal" required> PayPal
              </label>
              <label style="display:flex;align-items:center;gap:0.4rem;cursor:pointer">
                <input type="radio" name="payment_method" value="bank" required> Bank Transfer
              </label>
            </div>
          </div>
          <p class="datenschutz-notice"><%- t('event.privacy_consent') %> <a href="/privacy" target="_blank"><strong><%- t('event.privacy_policy') %></strong></a>.</p>
          <button type="submit" class="btn btn-primary"><%- t('event.submit') %></button>
        </form>
      </div>

    </div><!-- /.event-reg-layout -->
  </div>

  <% if (activeTier && activePrice) { %>
  <script>
  (function() {
    var pricePerAdult = <%= parseFloat(activePrice) %>;
    var groupMinSize  = <%- event.group_min_size  ? parseInt(event.group_min_size)    : 'null' %>;
    var groupDiscount = <%- event.group_discount   ? parseFloat(event.group_discount)  : 'null' %>;
    var adultsEl = document.getElementById('adults_count');
    var childrenEl = document.getElementById('children_count');
    var valueEl = document.getElementById('totalPriceValue');
    var hintEl  = document.getElementById('totalPriceHint');
    function updatePrice() {
      var a = parseInt(adultsEl.value) || 0;
      var c = parseInt(childrenEl.value) || 0;
      var subtotal = a * pricePerAdult;
      var multiplier = (groupMinSize && groupDiscount && a >= groupMinSize) ? Math.floor(a / groupMinSize) : 0;
      var discount = multiplier * (groupDiscount || 0);
      var total = Math.max(0, subtotal - discount).toFixed(2);
      valueEl.textContent = '€' + total;
      var parts = [];
      if (a > 0) parts.push(a + ' × €' + pricePerAdult.toFixed(2));
      if (c > 0) parts.push(c + ' child' + (c !== 1 ? 'ren' : '') + ' (free)');
      var hint = parts.join(' + ');
      if (discount > 0) hint += ' − ' + multiplier + ' × €' + groupDiscount.toFixed(2) + ' group discount';
      if (a > 0) hint += ' = €' + total;
      hintEl.textContent = hint;
    }
    if (adultsEl && valueEl) {
      adultsEl.addEventListener('input', updatePrice);
      childrenEl.addEventListener('input', updatePrice);
      updatePrice();
    }
  })();
  </script>
  <% } %>

  <script>
  (function() {
    var BN = '০১২৩৪৫৬৭৮৯';
    function toBN(n) { return String(n).replace(/[0-9]/g, function(d) { return BN[d]; }); }
    var _loc = '<%= locale %>';
    var _L = {
      bn: { pre: '⏰ শেষ হচ্ছে: ', d: ' দিন', h: ' ঘণ্টা', m: ' মিনিট', s: ' সেকেন্ড', num: toBN },
      en: { pre: '⏰ Ends in: ',   d: ' day', h: ' hr',    m: ' min',    s: ' sec',      num: String },
      de: { pre: '⏰ Endet in: ',  d: ' Tag', h: ' Std',   m: ' Min',    s: ' Sek',      num: String },
    }[_loc] || { pre: '⏰ Ends in: ', d: ' day', h: ' hr', m: ' min', s: ' sec', num: String };

    var eb  = <%- event.early_bird_deadline ? JSON.stringify(new Date(event.early_bird_deadline).getTime()) : 'null' %>;
    var mid = <%- event.mid_deadline        ? JSON.stringify(new Date(event.mid_deadline).getTime())        : 'null' %>;
    var evd = <%- event.event_date          ? JSON.stringify(new Date(event.event_date).getTime())          : 'null' %>;

    var TIERS = [
      { name: 'halide', keywords: [
        'হলদে বউঃ','হলদে বউ:','হলদে বউ',
        'Haldey Bou','Halde Bou','Halide Bou','Holde Bou',
        'Early Bird','Baya Weaver','Yellow Bird'
      ], deadline: eb, start: null },
      { name: 'nilkantha', keywords: [
        'নীলকণ্ঠঃ','নীলকণ্ঠ:','নীলকণ্ঠ',
        'Nilkantha','Nil Kantha','Neelkantha','Neel Kantha',
        'Blue Throat','Indian Roller'
      ], deadline: mid, start: eb },
      { name: 'kokila', keywords: [
        'কোকিলাঃ','কোকিলা:','কোকিলা',
        'Kokila','Koyel','Koyal',
        'Cuckoo','Indian Cuckoo'
      ], deadline: evd, start: mid },
    ];

    function fmt(ms) {
      var n = _L.num;
      var d = Math.floor(ms / 86400000);
      var h = Math.floor((ms % 86400000) / 3600000);
      var m = Math.floor((ms % 3600000) / 60000);
      var s = Math.floor((ms % 60000) / 1000);
      var parts = [];
      if (d > 0) parts.push(n(d) + _L.d);
      if (h > 0) parts.push(n(h) + _L.h);
      if (m > 0 || d > 0) parts.push(n(m) + _L.m);
      parts.push(n(s) + _L.s);
      return parts.join(' ');
    }

    function injectBadges(rootEl) {
      var result = [];
      TIERS.forEach(function(tier) {
        if (!tier.deadline) return;
        var candidates = rootEl.querySelectorAll('p, li, h2, h3, h4, h5, h6, strong, b, td');
        var target = null;
        for (var i = 0; i < candidates.length; i++) {
          var low = candidates[i].textContent.toLowerCase();
          if (tier.keywords.some(function(kw) { return low.indexOf(kw.toLowerCase()) !== -1; })) {
            target = candidates[i]; break;
          }
        }
        if (!target) {
          var low = rootEl.textContent.toLowerCase();
          if (tier.keywords.some(function(kw) { return low.indexOf(kw.toLowerCase()) !== -1; })) {
            target = rootEl;
          }
        }
        if (!target) return;
        var br = document.createElement('br');
        var badge = document.createElement('span');
        badge.className = 'tier-badge'; badge.style.display = 'none';
        target.appendChild(br); target.appendChild(badge);
        result.push({ el: badge, deadline: tier.deadline, start: tier.start, name: tier.name });
      });
      return result;
    }

    var payEl = document.getElementById('payDescBox');
    var badges = payEl ? injectBadges(payEl) : [];
    if (!badges.length) return;

    function tick() {
      var now = Date.now();
      badges.forEach(function(b) {
        var active = b.deadline && now < b.deadline && (!b.start || now >= b.start);
        if (!active) { b.el.style.display = 'none'; return; }
        b.el.style.display = 'inline-block';
        var rem = b.deadline - now;
        var urgency = rem < 6 * 3600000 ? 'urgent' : rem < 24 * 3600000 ? 'warning' : rem < 3 * 86400000 ? 'soon' : 'normal';
        b.el.className = 'tier-badge tier-badge--' + b.name + ' tier-badge--' + urgency;
        b.el.textContent = _L.pre + fmt(rem);
      });
    }
    tick(); setInterval(tick, 1000);
  })();
  </script>

  <% if (activeTier && (activeTier === 'early_bird' || activeTier === 'mid')) { %>
  <script>
  (function() {
    var BN = '০১২৩৪৫৬৭৮৯';
    function toBN(n) { return String(n).replace(/[0-9]/g, function(d) { return BN[d]; }); }
    var _loc = '<%= locale %>';
    var _L = {
      bn: { pre: '⏰ শেষ হচ্ছে: ', d: ' দিন', h: ' ঘণ্টা', m: ' মিনিট', s: ' সেকেন্ড', num: toBN },
      en: { pre: '⏰ Ends in: ',   d: ' day', h: ' hr',    m: ' min',    s: ' sec',      num: String },
      de: { pre: '⏰ Endet in: ',  d: ' Tag', h: ' Std',   m: ' Min',    s: ' Sek',      num: String },
    }[_loc] || { pre: '⏰ Ends in: ', d: ' day', h: ' hr', m: ' min', s: ' sec', num: String };

    var deadline = <%- activeTier === 'early_bird' && event.early_bird_deadline
      ? JSON.stringify(new Date(event.early_bird_deadline).getTime())
      : activeTier === 'mid' && event.mid_deadline
        ? JSON.stringify(new Date(event.mid_deadline).getTime())
        : 'null' %>;

    var el = document.getElementById('tierCountdown');
    if (!el || !deadline) return;

    function fmt(ms) {
      var n = _L.num;
      var d = Math.floor(ms / 86400000);
      var h = Math.floor((ms % 86400000) / 3600000);
      var m = Math.floor((ms % 3600000) / 60000);
      var s = Math.floor((ms % 60000) / 1000);
      var parts = [];
      if (d > 0) parts.push(n(d) + _L.d);
      if (h > 0) parts.push(n(h) + _L.h);
      if (m > 0 || d > 0) parts.push(n(m) + _L.m);
      parts.push(n(s) + _L.s);
      return parts.join(' ');
    }

    function tick() {
      var rem = deadline - Date.now();
      if (rem <= 0) { el.textContent = ''; return; }
      var urgency = rem < 6 * 3600000 ? 'urgent' : rem < 24 * 3600000 ? 'warning' : '';
      el.className = 'tier-countdown' + (urgency ? ' tier-countdown--' + urgency : '');
      el.textContent = _L.pre + fmt(rem);
    }
    tick();
    setInterval(tick, 1000);
  })();
  </script>
  <% } %>

  <script>
  (function() {
    var form  = document.querySelector('.register-form');
    var email = document.getElementById('email');
    var phone = document.getElementById('phone');
    var err   = document.getElementById('contactError');
    if (!form || !email || !phone) return;
    form.addEventListener('submit', function(e) {
      if (!email.value.trim() && !phone.value.trim()) {
        e.preventDefault();
        err.style.display = 'block';
        email.focus();
      } else {
        err.style.display = 'none';
      }
    });
    [email, phone].forEach(function(el) {
      el.addEventListener('input', function() {
        if (email.value.trim() || phone.value.trim()) err.style.display = 'none';
      });
    });
  })();
  </script>

  <% } else { %>
  <div class="event-detail-card" style="margin-top:1.5rem">
    <div class="registration-closed">
      <p><%- t('event.closed') %></p>
    </div>
  </div>
  <% } %>


</main>

<%- include('../partials/footer') %>
</div>
</body>
</html>
