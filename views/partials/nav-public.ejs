<nav class="nav-public" id="pubNav">
  <a href="/" class="nav-logo"><%- t('nav.logo') %></a>
  <button class="nav-pub-toggle" id="navPubToggle" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
  <div class="nav-links" id="pubNavLinks">
    <a href="/"><%- t('nav.events') %></a>
    <a href="/faq"><%- t('nav.faq') %></a>
    <a href="/privacy"><%- t('nav.privacy') %></a>
    <a href="/validate/login"><%- t('nav.volunteer') %></a>
    <a href="/admin"><%- t('nav.admin') %></a>
    <div class="lang-picker">
      <a href="?lang=bn" class="<%= locale === 'bn' ? 'lang-active' : '' %>">বাং</a>
      <a href="?lang=en" class="<%= locale === 'en' ? 'lang-active' : '' %>">EN</a>
      <a href="?lang=de" class="<%= locale === 'de' ? 'lang-active' : '' %>">DE</a>
    </div>
  </div>
</nav>
<script>
(function() {
  var btn = document.getElementById('navPubToggle');
  var links = document.getElementById('pubNavLinks');
  if (btn && links) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      links.classList.toggle('open');
    });
    document.addEventListener('click', function(e) {
      if (!e.target.closest('#pubNav')) links.classList.remove('open');
    });
  }
})();
</script>
