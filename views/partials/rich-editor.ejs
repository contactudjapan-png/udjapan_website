<script src="/vendor/jodit/jodit.min.js"></script>
<script>
(function() {
  document.querySelectorAll('textarea[data-rich]').forEach(function(ta) {
    var required = ta.hasAttribute('required');
    ta.removeAttribute('required');
    var editor = Jodit.make(ta, {
      height: 320,
      minHeight: 180,
      language: 'en',
      toolbarButtonSize: 'middle',
      buttons: 'bold,italic,underline,strikethrough,|,superscript,subscript,|,ul,ol,|,outdent,indent,|,font,fontsize,brush,paragraph,|,align,|,link,|,hr,|,eraser,copyformat,|,undo,redo,|,fullsize,source',
      showXPathInStatusbar: false,
      showCharsCounter: false,
      showWordsCounter: false,
      disablePlugins: 'speech-recognize',
      allowResizeX: false,
      allowResizeY: true,
    });
    if (required) {
      ta.closest('form').addEventListener('submit', function(e) {
        if (!editor.value.replace(/<[^>]*>/g, '').trim()) {
          e.preventDefault();
          editor.focus();
        }
      });
    }
  });
})();
</script>
