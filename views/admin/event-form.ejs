<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>
<%
function toBerlinInput(dateStr) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleString('sv', { timeZone: 'Europe/Berlin' }).slice(0, 16).replace(' ', 'T');
}
%>

<main class="admin-container">
  <% if (event) { %>
    <%- include('../partials/event-subnav') %>
  <% } %>

  <h1><%= event ? t('admin.pg_edit_event') : t('admin.pg_new_event') %></h1>

  <!-- ── Form 1: Event Info ──────────────────────────── -->
  <div class="admin-form-section">
    <h2><%- t('admin.section_event_info') %></h2>
    <form action="<%= event ? `/admin/events/${event.id}/edit` : '/admin/events/new' %>" method="POST" enctype="multipart/form-data" class="admin-form">
      <div class="form-group">
        <label for="title"><%- t('admin.lbl_event_title') %></label>
        <input type="text" id="title" name="title" required value="<%= event ? event.title : '' %>">
      </div>
      <div class="form-group">
        <label for="description"><%- t('admin.lbl_desc_bn') %></label>
        <textarea id="description" name="description" rows="6" data-rich><%= event ? event.description : '' %></textarea>
      </div>
      <div class="form-group">
        <label for="description_en">Description (English)</label>
        <textarea id="description_en" name="description_en" rows="6" data-rich><%= event ? (event.description_en || '') : '' %></textarea>
      </div>
      <div class="form-group">
        <label for="description_de">Beschreibung (Deutsch)</label>
        <textarea id="description_de" name="description_de" rows="6" data-rich><%= event ? (event.description_de || '') : '' %></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="event_date"><%- t('admin.field_datetime') %> *</label>
          <input type="datetime-local" id="event_date" name="event_date" required
            value="<%= event ? toBerlinInput(event.event_date) : '' %>">
        </div>
        <div class="form-group">
          <label for="max_capacity"><%- t('admin.field_capacity') %></label>
          <input type="number" id="max_capacity" name="max_capacity" min="1"
            value="<%= event ? (event.max_capacity || '') : '' %>">
        </div>
      </div>
      <div class="form-group">
        <label for="location"><%- t('admin.field_location') %></label>
        <input type="text" id="location" name="location" value="<%= event ? (event.location || '') : '' %>" placeholder="<%- t('admin.lbl_location_ph') %>">
      </div>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="is_active" <%= event && event.is_active ? 'checked' : '' %>>
          <%- t('admin.lbl_event_active') %>
        </label>
      </div>
      <% if (event) { %>
      <h3 style="margin-top:1.5rem;margin-bottom:0.75rem"><%- t('admin.banner_timed') %></h3>
      <p class="section-hint" style="margin-bottom:1rem"><%- t('admin.banner_hint') %></p>
      <div class="form-row">
        <div class="form-group">
          <label><%- t('admin.lbl_banner_early') %></label>
          <% if (event.banner_url) { %>
            <img src="<%= event.banner_url %>" alt="<%- t('admin.lbl_banner_early') %>" class="preview-img">
          <% } %>
          <input type="file" name="banner" accept="image/*">
        </div>
        <div class="form-group">
          <label><%- t('admin.lbl_banner_mid') %></label>
          <% if (event.banner_url_nilkantha) { %>
            <img src="<%= event.banner_url_nilkantha %>" alt="<%- t('admin.lbl_banner_mid') %>" class="preview-img">
          <% } %>
          <input type="file" name="banner_nilkantha" accept="image/*">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label><%- t('admin.lbl_banner_onspot') %></label>
          <% if (event.banner_url_kokila) { %>
            <img src="<%= event.banner_url_kokila %>" alt="<%- t('admin.lbl_banner_onspot') %>" class="preview-img">
          <% } %>
          <input type="file" name="banner_kokila" accept="image/*">
        </div>
        <div class="form-group">
          <label><%- t('admin.lbl_banner_post') %></label>
          <% if (event.banner_url_bd) { %>
            <img src="<%= event.banner_url_bd %>" alt="<%- t('admin.lbl_banner_post') %>" class="preview-img">
          <% } %>
          <input type="file" name="banner_bd" accept="image/*">
        </div>
      </div>
      <div class="form-row" style="margin-top:0.5rem">
        <div class="form-group">
          <label><%- t('admin.lbl_popup') %></label>
          <% if (event.popup_image_url) { %>
            <img src="<%= event.popup_image_url %>" alt="<%- t('admin.lbl_popup') %>" class="preview-img">
          <% } %>
          <input type="file" name="popup_image" accept="image/*">
          <small><%- t('admin.popup_hint') %></small>
        </div>
      </div>
      <% } %>
      <button type="submit" class="btn btn-primary"><%= event ? t('admin.btn_save_event_info') : t('admin.btn_create_event') %></button>
      <a href="/admin/events" class="btn btn-outline"><%- t('btn.cancel') %></a>
    </form>
  </div>

  <!-- ── Form 2: Payment Info (edit only) ───────────── -->
  <% if (event) { %>
  <div class="admin-form-section" style="margin-top:2rem">
    <h2><%- t('admin.section_payment') %></h2>
    <form action="/admin/events/<%= event.id %>/edit/payment" method="POST" enctype="multipart/form-data" class="admin-form">
      <div class="form-group">
        <label for="payment_description"><%- t('admin.lbl_pay_desc_bn') %></label>
        <textarea id="payment_description" name="payment_description" rows="4" data-rich placeholder="<%- t('admin.lbl_pay_desc_bn') %>"><%= event.payment_description || '' %></textarea>
      </div>
      <div class="form-group">
        <label for="payment_description_en">Payment Instructions (English)</label>
        <textarea id="payment_description_en" name="payment_description_en" rows="4" data-rich placeholder="Payment instructions shown on the public page"><%= event.payment_description_en || '' %></textarea>
      </div>
      <div class="form-group">
        <label for="payment_description_de">Zahlungsanweisungen (Deutsch)</label>
        <textarea id="payment_description_de" name="payment_description_de" rows="4" data-rich placeholder="Zahlungshinweise auf der öffentlichen Seite"><%= event.payment_description_de || '' %></textarea>
      </div>
      <p class="section-hint"><%- t('admin.price_hint') %></p>
      <div class="form-row">
        <div class="form-group">
          <label for="price_early_bird"><%- t('admin.lbl_price_early') %></label>
          <input type="number" id="price_early_bird" name="price_early_bird" min="0" step="0.01"
            value="<%= event.price_early_bird || '' %>" placeholder="0.00">
        </div>
        <div class="form-group">
          <label for="early_bird_deadline"><%- t('admin.lbl_deadline_early') %></label>
          <input type="datetime-local" id="early_bird_deadline" name="early_bird_deadline"
            value="<%= toBerlinInput(event.early_bird_deadline) %>">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="price_mid"><%- t('admin.lbl_price_mid') %></label>
          <input type="number" id="price_mid" name="price_mid" min="0" step="0.01"
            value="<%= event.price_mid || '' %>" placeholder="0.00">
        </div>
        <div class="form-group">
          <label for="mid_deadline"><%- t('admin.lbl_deadline_mid') %></label>
          <input type="datetime-local" id="mid_deadline" name="mid_deadline"
            value="<%= toBerlinInput(event.mid_deadline) %>">
          <small><%- t('admin.mid_hint') %></small>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="price_onspot"><%- t('admin.lbl_price_onspot') %></label>
          <input type="number" id="price_onspot" name="price_onspot" min="0" step="0.01"
            value="<%= event.price_onspot || '' %>" placeholder="0.00">
        </div>
        <div class="form-group">
          <label>&nbsp;</label>
          <p style="padding-top:0.5rem;font-size:0.85rem;color:var(--text-muted)"><%- t('admin.onspot_hint') %></p>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="group_min_size"><%- t('admin.lbl_group_min') %></label>
          <input type="number" id="group_min_size" name="group_min_size" min="2" step="1"
            value="<%= event.group_min_size || '' %>" placeholder="e.g. 5">
          <small><%- t('admin.lbl_group_min_hint') %></small>
        </div>
        <div class="form-group">
          <label for="group_discount"><%- t('admin.lbl_group_discount') %></label>
          <input type="number" id="group_discount" name="group_discount" min="0" step="1"
            value="<%= event.group_discount || '' %>" placeholder="0.00">
          <small><%- t('admin.lbl_group_discount_hint') %></small>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="price_student">Student / Opportunity Card Price (€)</label>
          <input type="number" id="price_student" name="price_student" min="0" step="0.01"
            value="<%= event.price_student || '' %>" placeholder="0.00">
          <small>Flat price shown when attendee checks the student/opportunity card box.</small>
        </div>
      </div>
      <div class="form-group">
        <label><%- t('admin.lbl_paypal_qr') %></label>
        <% if (event.paypal_qr_url) { %>
          <img src="<%= event.paypal_qr_url %>" alt="PayPal QR" class="preview-img preview-img--qr">
        <% } %>
        <input type="file" name="paypal_qr" accept="image/*">
      </div>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="registration_open" <%= event.registration_open ? 'checked' : '' %>>
          <%- t('admin.lbl_sub_open') %>
        </label>
      </div>
      <button type="submit" class="btn btn-primary"><%- t('admin.btn_save_payment') %></button>
    </form>
  </div>

  <hr style="margin-top:3rem">
  <div class="danger-zone" style="margin-top:2rem">
    <h2><%- t('admin.danger_zone') %></h2>
    <form action="/admin/events/<%= event.id %>/delete" method="POST"
      data-confirm="Delete &quot;<%= event.title.replace(/"/g, '&quot;') %>&quot;? This will permanently delete the event and ALL its data (registrations, expenses, polls, volunteers, etc.). This cannot be undone.">
      <button type="submit" class="btn btn-danger"><%- t('admin.btn_delete_event') %></button>
    </form>
  </div>
  <% } %>
</main>

<%- include('../partials/rich-editor') %>
<%- include('../partials/footer') %>
</body>
</html>
