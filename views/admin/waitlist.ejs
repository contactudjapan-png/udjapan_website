<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <h1>ওয়েটলিস্ট — <%= event.title %></h1>
  </div>

  <% if (waitlist.length === 0) { %>
    <div class="empty-state"><p>ওয়েটলিস্টে কেউ নেই।</p></div>
  <% } else { %>
    <table class="admin-table">
      <thead><tr>
        <th>#</th><th>নাম</th><th>ইমেইল</th><th>যোগ দিয়েছেন</th><th>কার্যক্রম</th>
      </tr></thead>
      <tbody>
      <% waitlist.forEach((entry, i) => { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= entry.name %></td>
          <td><%= entry.email %></td>
          <td><%= new Date(entry.created_at).toLocaleDateString('bn-BD', { timeZone: 'Europe/Berlin' }) %></td>
          <td class="action-cell">
            <form action="/admin/waitlist/<%= entry.id %>/promote" method="POST" style="display:inline" onsubmit="return confirm('এই ব্যক্তিকে নিবন্ধনে নিয়ে যাবেন?')">
              <button type="submit" class="btn btn-sm btn-success">নিবন্ধনে নিন</button>
            </form>
            <form action="/admin/waitlist/<%= entry.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('ওয়েটলিস্ট থেকে সরাবেন?')">
              <button type="submit" class="btn btn-sm btn-danger">সরান</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
