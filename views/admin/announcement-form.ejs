<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <div class="section-header">
    <h1><%= announcement ? t('admin.pg_edit_announcement') : t('admin.pg_new_announcement') %></h1>
    <a href="/admin/announcements" class="btn btn-outline"><%- t('btn.back') %></a>
  </div>

  <form action="<%= announcement ? `/admin/announcements/${announcement.id}/edit` : '/admin/announcements/new' %>" method="POST" class="admin-form" style="max-width:600px">
    <div class="form-group">
      <label for="title"><%- t('admin.lbl_title') %></label>
      <input type="text" id="title" name="title" required value="<%= announcement ? announcement.title : '' %>" placeholder="<%- t('admin.ann_content_ph') %>">
    </div>
    <div class="form-group">
      <label for="content"><%- t('admin.lbl_content_bn') %></label>
      <textarea id="content" name="content" rows="5" required data-rich placeholder="<%- t('admin.ann_content_ph') %>"><%= announcement ? announcement.content : '' %></textarea>
    </div>
    <div class="form-group">
      <label for="title_en">Title (English)</label>
      <input type="text" id="title_en" name="title_en" value="<%= announcement ? (announcement.title_en || '') : '' %>" placeholder="Announcement title">
    </div>
    <div class="form-group">
      <label for="content_en">Content (English)</label>
      <textarea id="content_en" name="content_en" rows="4" data-rich placeholder="Announcement details..."><%= announcement ? (announcement.content_en || '') : '' %></textarea>
    </div>
    <div class="form-group">
      <label for="title_de">Titel (Deutsch)</label>
      <input type="text" id="title_de" name="title_de" value="<%= announcement ? (announcement.title_de || '') : '' %>" placeholder="Ankündigungstitel">
    </div>
    <div class="form-group">
      <label for="content_de">Inhalt (Deutsch)</label>
      <textarea id="content_de" name="content_de" rows="4" data-rich placeholder="Ankündigungsdetails..."><%= announcement ? (announcement.content_de || '') : '' %></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="link_url"><%- t('admin.lbl_link_url') %></label>
        <input type="url" id="link_url" name="link_url" value="<%= announcement ? (announcement.link_url || '') : '' %>" placeholder="https://...">
      </div>
      <div class="form-group">
        <label for="link_text"><%- t('admin.lbl_link_text') %></label>
        <input type="text" id="link_text" name="link_text" value="<%= announcement ? (announcement.link_text || '') : '' %>" placeholder="<%- t('admin.lbl_link_text_ph') %>">
      </div>
    </div>
    <div class="form-group">
      <label for="sort_order"><%- t('admin.lbl_sort_order') %></label>
      <input type="number" id="sort_order" name="sort_order" value="<%= announcement ? announcement.sort_order : 0 %>" min="0">
      <small><%- t('admin.sort_order_hint') %></small>
    </div>
    <% if (announcement) { %>
    <div class="form-group">
      <label>
        <input type="checkbox" name="is_active" <%= announcement.is_active ? 'checked' : '' %>>
        <%- t('admin.lbl_is_active') %>
      </label>
    </div>
    <% } %>
    <button type="submit" class="btn btn-primary"><%= announcement ? t('btn.update') : t('btn.create') %></button>
  </form>
</main>

<%- include('../partials/rich-editor') %>
<%- include('../partials/footer') %>
</body>
</html>
