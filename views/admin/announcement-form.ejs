<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <div class="section-header">
    <h1><%= announcement ? 'ঘোষণা সম্পাদনা' : 'নতুন ঘোষণা' %></h1>
    <a href="/admin/announcements" class="btn btn-outline">← ফিরুন</a>
  </div>

  <form action="<%= announcement ? `/admin/announcements/${announcement.id}/edit` : '/admin/announcements/new' %>" method="POST" class="admin-form" style="max-width:600px">
    <div class="form-group">
      <label for="title">শিরোনাম *</label>
      <input type="text" id="title" name="title" required value="<%= announcement ? announcement.title : '' %>" placeholder="ঘোষণার শিরোনাম">
    </div>
    <div class="form-group">
      <label for="content">বিষয়বস্তু (বাংলা) *</label>
      <textarea id="content" name="content" rows="5" required data-rich placeholder="ঘোষণার বিস্তারিত লিখুন..."><%= announcement ? announcement.content : '' %></textarea>
    </div>
    <div class="form-group">
      <label for="title_en">Title (English)</label>
      <input type="text" id="title_en" name="title_en" value="<%= announcement ? (announcement.title_en || '') : '' %>" placeholder="Announcement title">
    </div>
    <div class="form-group">
      <label for="content_en">Content (English)</label>
      <textarea id="content_en" name="content_en" rows="4" data-rich placeholder="Announcement details..."><%= announcement ? (announcement.content_en || '') : '' %></textarea>
    </div>
    <div class="form-group">
      <label for="title_de">Titel (Deutsch)</label>
      <input type="text" id="title_de" name="title_de" value="<%= announcement ? (announcement.title_de || '') : '' %>" placeholder="Ankündigungstitel">
    </div>
    <div class="form-group">
      <label for="content_de">Inhalt (Deutsch)</label>
      <textarea id="content_de" name="content_de" rows="4" data-rich placeholder="Ankündigungsdetails..."><%= announcement ? (announcement.content_de || '') : '' %></textarea>
    </div>
    <div class="form-group">
      <label for="sort_order">ক্রম</label>
      <input type="number" id="sort_order" name="sort_order" value="<%= announcement ? announcement.sort_order : 0 %>" min="0">
      <small>ছোট সংখ্যা আগে দেখাবে।</small>
    </div>
    <% if (announcement) { %>
    <div class="form-group">
      <label>
        <input type="checkbox" name="is_active" <%= announcement.is_active ? 'checked' : '' %>>
        সক্রিয়
      </label>
    </div>
    <% } %>
    <button type="submit" class="btn btn-primary"><%= announcement ? 'আপডেট করুন' : 'তৈরি করুন' %></button>
  </form>
</main>

<%- include('../partials/rich-editor') %>
<%- include('../partials/footer') %>
</body>
</html>
