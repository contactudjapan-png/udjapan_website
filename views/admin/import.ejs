<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <h1>Import Historical Data — <%= event.title %></h1>

  <div class="admin-form-card">
    <p>Upload an Excel (.xlsx) file to import historical registrations and expenses. The file should contain one or both of these sheets:</p>

    <div class="import-spec">
      <h3>Sheet: <code>Registrations</code></h3>
      <table class="admin-table">
        <thead><tr><th>Column</th><th>Type</th><th>Required</th><th>Notes</th></tr></thead>
        <tbody>
          <tr><td><code>name</code></td><td>text</td><td>Yes</td><td>Full name</td></tr>
          <tr><td><code>email</code></td><td>text</td><td>Yes</td><td>Email address</td></tr>
          <tr><td><code>payment_reference</code></td><td>text</td><td>No</td><td>PayPal ID or reference</td></tr>
          <tr><td><code>is_paid</code></td><td>yes/no or true/false</td><td>No</td><td>Payment status (default: false)</td></tr>
        </tbody>
      </table>

      <h3 style="margin-top:1.5rem">Sheet: <code>Expenses</code></h3>
      <table class="admin-table">
        <thead><tr><th>Column</th><th>Type</th><th>Required</th><th>Notes</th></tr></thead>
        <tbody>
          <tr><td><code>description</code></td><td>text</td><td>Yes</td><td>Expense description</td></tr>
          <tr><td><code>amount</code></td><td>number</td><td>Yes</td><td>Amount in EUR</td></tr>
        </tbody>
      </table>
    </div>

    <form action="/admin/events/<%= event.id %>/import" method="POST" enctype="multipart/form-data" style="margin-top:1.5rem">
      <div class="form-group">
        <label for="excel_file">Excel File (.xlsx) *</label>
        <input type="file" id="excel_file" name="excel_file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required>
      </div>
      <button type="submit" class="btn btn-primary">Import Data</button>
      <a href="/admin/events/<%= event.id %>/registrations" class="btn btn-outline">Cancel</a>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
