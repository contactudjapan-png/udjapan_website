<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <h1>Send Email — <%= event.title %></h1>

  <div class="info-box">
    <p>This will send an email to all registered attendees of this event.</p>
    <% if (!process.env.SMTP_HOST) { %>
      <p class="warning">⚠️ SMTP is not configured — emails will be logged but not actually sent.</p>
    <% } %>
  </div>

  <form action="/admin/events/<%= event.id %>/emails/send" method="POST" class="admin-form" onsubmit="return confirm('Send this email to all attendees?')">
    <div class="form-group">
      <label for="subject">Subject *</label>
      <input type="text" id="subject" name="subject" required placeholder="Event Update: ...">
    </div>
    <div class="form-group">
      <label for="body">Message *</label>
      <textarea id="body" name="body" rows="10" required placeholder="Write your message here..."></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Send Email</button>
    <a href="/admin/events/<%= event.id %>/registrations" class="btn btn-outline">Cancel</a>
  </form>
</main>

<%- include('../partials/footer') %>
</body>
</html>
