<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>
<% var _dateLocale = locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-GB' : 'bn-BD'; %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <h1><%- t('admin.pg_send_email') %> — <%= event.title %></h1>

  <div class="info-box">
    <p><%- t('admin.email_info') %></p>
    <% if (!process.env.SMTP_HOST) { %>
      <p class="warning"><%- t('admin.smtp_warning') %></p>
    <% } %>
  </div>

  <form action="/admin/events/<%= event.id %>/emails/send" method="POST" class="admin-form" data-confirm="Send this email to all attendees?">
    <div class="form-group">
      <label for="subject"><%- t('admin.lbl_subject') %></label>
      <input type="text" id="subject" name="subject" required placeholder="Event Update: ...">
    </div>
    <div class="form-group">
      <label for="body"><%- t('admin.lbl_body') %></label>
      <textarea id="body" name="body" rows="10" required data-rich placeholder="Write your message here..."></textarea>
    </div>
    <button type="submit" class="btn btn-primary"><%- t('admin.btn_send_email') %></button>
    <a href="/admin/events/<%= event.id %>/registrations" class="btn btn-outline"><%- t('btn.cancel') %></a>
  </form>

  <% if (emailLogs && emailLogs.length > 0) { %>
  <div style="margin-top:2rem">
    <h2 style="margin-bottom:1rem"><%- t('admin.email_sent_log') %></h2>
    <table class="admin-table">
      <thead><tr>
        <th><%- t('tbl.date') %></th>
        <th><%- t('admin.lbl_subject') %></th>
        <th><%- t('admin.email_recipients') %></th>
        <th><%- t('email.opens') %></th>
      </tr></thead>
      <tbody>
      <% emailLogs.forEach(log => { %>
        <tr>
          <td style="white-space:nowrap"><%= new Date(log.sent_at).toLocaleString(_dateLocale, { timeZone: 'Europe/Berlin' }) %></td>
          <td><%= log.subject %></td>
          <td><%= log.recipient_count %></td>
          <td><%= log.open_count || 0 %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</main>

<%- include('../partials/rich-editor') %>
<%- include('../partials/footer') %>
</body>
</html>
