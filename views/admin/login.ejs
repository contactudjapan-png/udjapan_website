<%- include('../partials/head') %>
<body class="login-page">

<main class="login-container">
  <div class="login-card">
    <h1 class="login-title"><%- t('admin.login_title') %></h1>
    <%- include('../partials/flash') %>
    <form action="/admin/login" method="POST" class="login-form">
      <div class="form-group">
        <label for="email"><%- t('admin.lbl_login_email') %></label>
        <input type="email" id="email" name="email" required autofocus placeholder="admin@example.com">
      </div>
      <div class="form-group">
        <label for="password"><%- t('admin.lbl_login_password') %></label>
        <input type="password" id="password" name="password" required placeholder="••••••••">
      </div>
      <button type="submit" class="btn btn-primary btn-full"><%- t('btn.login') %></button>
    </form>
  </div>
</main>

</body>
</html>
