<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <h1><%- t('admin.pg_add_refund') %> — <%= event.title %></h1>

  <form action="/admin/events/<%= event.id %>/refunds/new" method="POST" class="admin-form">
    <div class="form-row">
      <div class="form-group">
        <label for="amount"><%- t('admin.lbl_refund_amount') %></label>
        <input type="number" id="amount" name="amount" step="0.01" min="0" required>
      </div>
      <div class="form-group">
        <label for="transaction_id"><%- t('admin.lbl_refund_txn_id') %></label>
        <input type="text" id="transaction_id" name="transaction_id" placeholder="<%- t('admin.lbl_refund_txn_id') %>">
      </div>
    </div>
    <div class="form-group">
      <label for="registration_id"><%- t('admin.lbl_reg_optional') %></label>
      <select id="registration_id" name="registration_id">
        <option value=""><%- t('admin.select_income_cat') %></option>
        <% registrations.forEach(reg => { %>
          <option value="<%= reg.id %>"><%= reg.name %> (<%= reg.email %>)</option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label for="reason"><%- t('admin.lbl_reason') %></label>
      <textarea id="reason" name="reason" rows="3" placeholder="<%- t('admin.reason_ph') %>"></textarea>
    </div>
    <button type="submit" class="btn btn-primary"><%- t('admin.btn_save_refund') %></button>
    <a href="/admin/events/<%= event.id %>/refunds" class="btn btn-outline"><%- t('btn.cancel') %></a>
  </form>
</main>

<%- include('../partials/footer') %>
</body>
</html>
