<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>
<% var _dateLocale = locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-GB' : 'bn-BD'; %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <h1><%- t('admin.pg_registrations') %> — <%= event.title %></h1>
    <a href="/admin/events/<%= event.id %>/registrations/new" class="btn btn-primary"><%- t('btn.add_manually') %></a>
  </div>

  <div class="reg-summary">
    <span><strong><%= registrations.length %></strong> <%- t('admin.total') %></span>
    <span><strong><%= registrations.filter(r=>r.is_paid).length %></strong> <%- t('admin.status_paid') %></span>
    <span><strong><%= registrations.filter(r=>!r.is_paid).length %></strong> <%- t('admin.status_pending') %></span>
  </div>

  <% if (registrations.length === 0) { %>
    <div class="empty-state"><p><%- t('admin.empty_regs') %></p></div>
  <% } else { %>
    <table class="admin-table">
      <thead><tr>
        <th><%- t('tbl.name') %></th><th><%- t('tbl.email') %></th><th><%- t('tbl.phone') %></th><th><%- t('tbl.amount') %></th><th><%- t('tbl.transaction_id') %></th><th><%- t('tbl.status') %></th><th><%- t('tbl.registered') %></th><th><%- t('tbl.actions') %></th>
      </tr></thead>
      <tbody>
      <% registrations.forEach(reg => { %>
        <tr>
          <td><%= reg.name %></td>
          <td><%= reg.email %></td>
          <td><%= reg.phone || '—' %></td>
          <td><% if (reg.amount) { %>€<%= parseFloat(reg.amount).toFixed(2) %><% } else { %>—<% } %></td>
          <td><% if (reg.transaction_id) { %><code style="font-size:0.78rem"><%= reg.transaction_id %></code><% } else { %><%= reg.payment_reference || '—' %><% } %></td>
          <td>
            <span class="badge <%= reg.is_paid ? 'badge-paid' : 'badge-pending' %>">
              <%= reg.is_paid ? t('admin.status_paid') : t('admin.status_pending') %>
            </span>
          </td>
          <td><%= new Date(reg.created_at).toLocaleDateString(_dateLocale, { timeZone: 'Europe/Berlin' }) %></td>
          <td class="action-cell">
            <form action="/admin/registrations/<%= reg.id %>/toggle-paid" method="POST" style="display:inline">
              <button type="submit" class="btn btn-sm <%= reg.is_paid ? 'btn-outline' : 'btn-success' %>">
                <%= reg.is_paid ? t('btn.toggle_unpaid') : t('btn.toggle_paid') %>
              </button>
            </form>
            <form action="/admin/registrations/<%= reg.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('এই নিবন্ধন মুছে ফেলবেন?')">
              <button type="submit" class="btn btn-sm btn-danger"><%- t('btn.delete') %></button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
