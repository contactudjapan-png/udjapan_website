<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>
<% var _dateLocale = locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-GB' : 'bn-BD'; %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <h1><%- t('admin.pg_registrations') %> — <%= event.title %></h1>
    <a href="/admin/events/<%= event.id %>/registrations/new" class="btn btn-primary"><%- t('btn.add_manually') %></a>
  </div>

  <% const _all = locals.allRegistrations || registrations; %>
  <% const _active = _all.filter(r => !r.is_cancelled); const _cancelled = _all.filter(r => r.is_cancelled); %>
  <%
    const _totalAdults   = _active.reduce((s, r) => s + (parseInt(r.adults_count)   || 0), 0);
    const _totalChildren = _active.reduce((s, r) => s + (parseInt(r.children_count) || 0), 0);
    const _specialCount  = _active.filter(r => r.is_special_needs).length;
    const _paidRegs      = _active.filter(r => r.is_paid);
    const _totalExpected = _active.reduce((s, r) => s + (r.computed ? r.computed.amount : (parseFloat(r.amount) || 0)), 0);
    const _totalActualPaid = _paidRegs.reduce((s, r) => s + (r.computed ? r.computed.amount : (parseFloat(r.amount) || 0)), 0);
  %>
  <div class="reg-summary">
    <span><strong><%= _all.length %></strong> <%- t('admin.total') %></span>
    <span><strong><%= _paidRegs.length %></strong> <%- t('admin.status_paid') %></span>
    <span><strong><%= _active.filter(r=>!r.is_paid).length %></strong> <%- t('admin.status_pending') %></span>
    <span><strong><%= _totalAdults %></strong> <%- t('reg.total_adults') %></span>
    <span><strong><%= _totalChildren %></strong> <%- t('reg.total_children') %></span>
    <% if (_totalExpected > 0) { %><span title="Expected from all active registrations"><strong>€<%= _totalExpected.toFixed(2) %></strong> Expected</span><% } %>
    <% if (_totalActualPaid > 0) { %><span title="Expected from paid registrations" style="color:var(--success)"><strong>€<%= _totalActualPaid.toFixed(2) %></strong> Collected</span><% } %>
    <% if (_specialCount > 0) { %><span><strong><%= _specialCount %></strong> ♿ <%- t('reg.special_needs') %></span><% } %>
    <% if (_cancelled.length > 0) { %><span><strong><%= _cancelled.length %></strong> <%- t('reg.cancelled') %></span><% } %>
  </div>

  <% if (_all.length === 0) { %>
    <div class="empty-state"><p><%- t('admin.empty_regs') %></p></div>
  <% } else { %>
    <table class="admin-table reg-table">
      <thead><tr>
        <th style="min-width:120px;max-width:180px"><%- t('tbl.name') %></th>
        <th style="min-width:140px;max-width:200px"><%- t('tbl.email') %></th>
        <th style="width:130px;white-space:nowrap"><%- t('tbl.phone') %></th>
        <th style="width:60px;white-space:nowrap;text-align:center"><%- t('reg.adults') %></th>
        <th style="width:60px;white-space:nowrap;text-align:center"><%- t('reg.children') %></th>
        <th style="width:70px;white-space:nowrap"><%- t('tbl.amount') %></th>
        <th style="width:80px;white-space:nowrap">Payment</th>
        <th style="width:140px"><%- t('tbl.transaction_id') %></th>
        <th style="width:80px;white-space:nowrap"><%- t('tbl.status') %></th>
        <th style="width:90px;white-space:nowrap"><%- t('tbl.registered') %></th>
        <th><%- t('tbl.actions') %></th>
      </tr></thead>
      <tbody>
      <% registrations.forEach(reg => { %>
        <tr class="<%= reg.is_cancelled ? 'reg-row-cancelled' : '' %>">
          <td style="min-width:120px;max-width:180px;word-break:break-word;white-space:normal">
            <%= reg.name %>
            <% if (reg.is_special_needs) { %><span class="badge-special" title="<%- t('reg.special_needs') %>">♿</span><% } %>
          </td>
          <td style="font-size:0.82rem;min-width:140px;max-width:200px;word-break:break-all;white-space:normal"><%= reg.email %></td>
          <td style="width:130px;white-space:nowrap;font-size:0.82rem"><%= reg.phone || '—' %></td>
          <td style="width:60px;text-align:center"><%= reg.adults_count || 0 %></td>
          <td style="width:60px;text-align:center"><%= reg.children_count || 0 %></td>
          <td style="width:90px">
            <% const _exp = reg.computed ? reg.computed.amount : null; %>
            <% const _paid = reg.amount ? parseFloat(reg.amount) : null; %>
            <% if (_exp != null) { %>
              <span title="<%= reg.computed.tier %>">€<%= _exp.toFixed(2) %></span>
              <% if (reg.computed) { %><br><small style="color:var(--text-muted);font-size:0.72rem"><%= reg.computed.tier %></small><% } %>
              <% if (_paid != null && Math.abs(_paid - _exp) > 0.01) { %>
                <br><small style="color:var(--danger);font-size:0.72rem">Paid: €<%= _paid.toFixed(2) %></small>
              <% } %>
            <% } else if (_paid != null) { %>
              €<%= _paid.toFixed(2) %>
            <% } else { %>—<% } %>
          </td>
          <td style="width:80px;font-size:0.82rem">
            <% if (reg.payment_method === 'paypal') { %>🅿 PayPal<% } else if (reg.payment_method === 'bank') { %>🏦 Bank<% } else { %>—<% } %>
          </td>
          <td style="width:140px;font-size:0.78rem;word-break:break-all;white-space:normal">
            <% if (reg.transaction_id) { %><code><%= reg.transaction_id %></code><% } else { %><%= reg.payment_reference || '—' %><% } %>
          </td>
          <td>
            <% if (reg.is_cancelled) { %>
              <span class="badge badge-cancelled"><%- t('reg.cancelled') %></span>
            <% } else { %>
              <span class="badge <%= reg.is_paid ? 'badge-paid' : 'badge-pending' %>">
                <%= reg.is_paid ? t('admin.status_paid') : t('admin.status_pending') %>
              </span>
            <% } %>
          </td>
          <td><%= new Date(reg.created_at).toLocaleDateString(_dateLocale, { timeZone: 'Europe/Berlin' }) %></td>
          <td class="action-cell action-cell--wrap">
            <a href="/admin/registrations/<%= reg.id %>/edit" class="btn btn-sm btn-outline"><%- t('btn.edit') %></a>
            <% if (!reg.is_cancelled) { %>
              <form action="/admin/registrations/<%= reg.id %>/toggle-paid" method="POST">
                <button type="submit" class="btn btn-sm <%= reg.is_paid ? 'btn-outline' : 'btn-success' %>">
                  <%= reg.is_paid ? t('btn.toggle_unpaid') : t('btn.toggle_paid') %>
                </button>
              </form>
              <form action="/admin/registrations/<%= reg.id %>/cancel" method="POST" data-confirm="নিবন্ধন বাতিল করবেন?">
                <button type="submit" class="btn btn-sm btn-outline"><%- t('btn.cancel_reg') %></button>
              </form>
            <% } else { %>
              <form action="/admin/registrations/<%= reg.id %>/reinstate" method="POST">
                <button type="submit" class="btn btn-sm btn-success"><%- t('btn.reinstate') %></button>
              </form>
            <% } %>
            <% if (reg.email && reg.email.includes('@') && !reg.is_cancelled) { %>
              <form action="/admin/registrations/<%= reg.id %>/resend-email" method="POST">
                <button type="submit" class="btn btn-sm btn-outline">📧 Resend</button>
              </form>
            <% } %>
            <form action="/admin/registrations/<%= reg.id %>/delete" method="POST" data-confirm="এই নিবন্ধন মুছে ফেলবেন?">
              <button type="submit" class="btn btn-sm btn-danger"><%- t('btn.delete') %></button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>

    <% if (locals.totalPages && totalPages > 1) { %>
      <nav class="pagination">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>" class="btn btn-sm btn-outline">‹ Prev</a>
        <% } else { %>
          <span class="btn btn-sm btn-outline" style="opacity:0.4;cursor:default">‹ Prev</span>
        <% } %>

        <% for (let p = 1; p <= totalPages; p++) { %>
          <% if (p === currentPage) { %>
            <span class="btn btn-sm btn-primary"><%= p %></span>
          <% } else if (p === 1 || p === totalPages || Math.abs(p - currentPage) <= 2) { %>
            <a href="?page=<%= p %>" class="btn btn-sm btn-outline"><%= p %></a>
          <% } else if (Math.abs(p - currentPage) === 3) { %>
            <span style="padding:0 4px;line-height:2">…</span>
          <% } %>
        <% } %>

        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>" class="btn btn-sm btn-outline">Next ›</a>
        <% } else { %>
          <span class="btn btn-sm btn-outline" style="opacity:0.4;cursor:default">Next ›</span>
        <% } %>

        <span style="color:var(--text-muted);font-size:0.85rem;margin-left:0.5rem">
          <%= (currentPage - 1) * pageSize + 1 %>–<%= Math.min(currentPage * pageSize, _all.length) %> of <%= _all.length %>
        </span>
      </nav>
    <% } %>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
