<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>
<% var _dateLocale = locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-GB' : 'bn-BD'; %>

<main class="admin-container">
  <h1><%- t('admin.pg_dashboard') %></h1>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-number"><%= stats.totalEvents %></div>
      <div class="stat-label"><%- t('admin.stat_total_events') %></div>
    </div>
    <div class="stat-card">
      <div class="stat-number"><%= stats.activeEvents %></div>
      <div class="stat-label"><%- t('admin.stat_active_events') %></div>
    </div>
    <div class="stat-card">
      <div class="stat-number"><%= stats.totalRegistrations %></div>
      <div class="stat-label"><%- t('admin.stat_total_regs') %></div>
    </div>
    <div class="stat-card">
      <div class="stat-number"><%= stats.paidRegistrations %></div>
      <div class="stat-label"><%- t('admin.stat_paid_regs') %></div>
    </div>
  </div>

  <div class="section-header">
    <h2><%- t('admin.events') %></h2>
    <div style="display:flex;gap:8px;align-items:center">
      <a href="/admin/events/new" class="btn btn-primary"><%- t('btn.new_event') %></a>
      <% if (useMemoryDb) { %>
      <form action="/admin/seed" method="POST" data-confirm="পরীক্ষামূলক ডেটা যোগ করবেন? (৩টি ইভেন্ট, ২০০ নিবন্ধন, ৫০ খরচ, ২০ স্টল, ১৫ স্বেচ্ছাসেবী প্রতিটিতে)">
        <button type="submit" class="btn btn-outline"><%- t('btn.load_test_data') %></button>
      </form>
      <% } %>
    </div>
  </div>

  <% if (stats.eventStats.length === 0) { %>
    <div class="empty-state"><p><%- t('admin.empty_events') %> <a href="/admin/events/new"><%- t('admin.create_first_event') %></a></p></div>
  <% } else { %>
    <table class="admin-table">
      <thead><tr>
        <th><%- t('tbl.event') %></th><th><%- t('tbl.date') %></th><th><%- t('tbl.status') %></th><th><%- t('tbl.registrations') %></th><th><%- t('tbl.actions') %></th>
      </tr></thead>
      <tbody>
      <% stats.eventStats.forEach(event => { %>
        <tr>
          <td><strong><%= event.title %></strong></td>
          <td><%= new Date(event.event_date).toLocaleDateString(_dateLocale, { timeZone: 'Europe/Berlin' }) %></td>
          <td>
            <% if (event.is_active) { %><span class="badge badge-open"><%- t('admin.badge_active') %></span><% } else { %><span class="badge badge-closed"><%- t('admin.badge_inactive') %></span><% } %>
          </td>
          <td><%= event.paidCount %> <%- t('admin.status_paid') %> / <%= event.regCount %> <%- t('admin.total') %></td>
          <td class="action-cell">
            <a href="/admin/events/<%= event.id %>" class="btn btn-sm btn-primary"><%- t('btn.details') %></a>
            <a href="/admin/events/<%= event.id %>/submissions" class="btn btn-sm"><%- t('subnav.submissions') %></a>
            <a href="/admin/events/<%= event.id %>/registrations" class="btn btn-sm"><%- t('subnav.registrations') %></a>
            <a href="/admin/events/<%= event.id %>/expenses" class="btn btn-sm"><%- t('subnav.expenses') %></a>
            <a href="/admin/events/<%= event.id %>/reports" class="btn btn-sm"><%- t('subnav.reports') %></a>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
