<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <div class="section-header">
    <h1><%- t('admin.pg_translations') %></h1>
  </div>

  <p style="color:var(--text-muted);margin-bottom:1rem">
    <%- t('admin.translations_hint') %> <strong>বাংলা (bn)</strong>, <strong>English (en)</strong>, <strong>Deutsch (de)</strong>।
    ব্যবহারকারীরা সাইটের নিচে ভাষা নির্বাচন করতে পারবেন।
  </p>

  <details style="margin-bottom:1.5rem">
    <summary class="btn btn-outline" style="cursor:pointer;display:inline-block"><%- t('btn.new_key') %></summary>
    <div style="padding:1rem;background:var(--bg);border-radius:var(--radius);margin-top:0.5rem;max-width:500px">
      <form action="/admin/translations/add-key" method="POST">
        <div class="form-group">
          <label><%- t('admin.lbl_key') %></label>
          <input type="text" name="key" required placeholder="nav.new_link" class="form-control">
        </div>
        <div class="form-group">
          <label><%- t('admin.lbl_bn_value') %></label>
          <input type="text" name="value" required placeholder="<%- t('admin.set_value_ph') %>" class="form-control">
        </div>
        <button type="submit" class="btn btn-primary"><%- t('btn.add_key') %></button>
      </form>
    </div>
  </details>

  <div style="margin-bottom:1rem">
    <input type="text" id="tr-search" placeholder="<%- t('admin.search_ph') %>" style="padding:0.4rem 0.7rem;border:1px solid var(--border);border-radius:var(--radius);width:280px;font-size:0.9rem">
  </div>

  <form action="/admin/translations" method="POST" id="tr-form">
    <div style="margin-bottom:1rem">
      <button type="submit" class="btn btn-primary"><%- t('btn.save_all') %></button>
    </div>
    <table class="admin-table" id="tr-table">
      <thead>
        <tr>
          <th style="min-width:180px"><%- t('tbl.key') %></th>
          <% SUPPORTED_LOCALES.forEach(loc => { %>
            <th>
              <% if (loc === 'bn') { %>বাংলা<% } else if (loc === 'en') { %>English<% } else if (loc === 'de') { %>Deutsch<% } else { %><%= loc %><% } %>
            </th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% keys.forEach(key => { %>
          <tr class="tr-row" data-key="<%= key %>">
            <td style="font-family:monospace;font-size:0.8rem;color:var(--text-muted)"><%= key %></td>
            <% SUPPORTED_LOCALES.forEach(loc => { %>
              <td>
                <input
                  type="text"
                  name="t[<%= key %>][<%= loc %>]"
                  value="<%= (all[loc] && all[loc][key]) ? all[loc][key] : '' %>"
                  placeholder="<%= loc === 'bn' ? t('admin.set_value_ph') : t('admin.opt_value_ph') %>"
                  style="width:100%;box-sizing:border-box;padding:0.3rem 0.5rem;border:1px solid var(--border);border-radius:4px;font-size:0.85rem;font-family:inherit"
                >
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div style="margin-top:1rem">
      <button type="submit" class="btn btn-primary"><%- t('btn.save_all') %></button>
    </div>
  </form>
</main>

<script>
(function() {
  var search = document.getElementById('tr-search');
  var rows = document.querySelectorAll('.tr-row');
  search.addEventListener('input', function() {
    var q = this.value.toLowerCase().trim();
    rows.forEach(function(row) {
      if (!q) { row.style.display = ''; return; }
      var key = row.dataset.key.toLowerCase();
      var vals = Array.from(row.querySelectorAll('input')).map(function(i) { return i.value.toLowerCase(); }).join(' ');
      row.style.display = (key.includes(q) || vals.includes(q)) ? '' : 'none';
    });
  });
})();
</script>

<%- include('../partials/footer') %>
</body>
</html>
