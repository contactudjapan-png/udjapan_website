<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <h1>আর্থিক ড্যাশবোর্ড — <%= event.title %></h1>

  <!-- Summary Cards -->
  <div class="stats-grid" style="grid-template-columns:repeat(auto-fill,minmax(180px,1fr));margin-bottom:2rem">
    <div class="stat-card">
      <div class="stat-number" style="color:var(--success)">€<%= summary.totalIncome.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></div>
      <div class="stat-label">মোট আয়</div>
    </div>
    <div class="stat-card">
      <div class="stat-number" style="color:var(--danger)">€<%= summary.totalExpenses.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></div>
      <div class="stat-label">মোট খরচ</div>
    </div>
    <div class="stat-card">
      <div class="stat-number" style="color:var(--warning)">€<%= summary.totalRefunds.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></div>
      <div class="stat-label">মোট রিফান্ড</div>
    </div>
    <div class="stat-card">
      <div class="stat-number" style="color:<%= summary.netProfit >= 0 ? 'var(--success)' : 'var(--danger)' %>">
        <%= summary.netProfit >= 0 ? '' : '-' %>€<%= Math.abs(summary.netProfit).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %>
      </div>
      <div class="stat-label">নেট <%= summary.netProfit >= 0 ? 'লাভ' : 'ক্ষতি' %></div>
    </div>
    <div class="stat-card">
      <div class="stat-number"><%= summary.paidCount %></div>
      <div class="stat-label">পরিশোধিত নিবন্ধন</div>
    </div>
    <div class="stat-card">
      <div class="stat-number" style="color:var(--warning)"><%= summary.unpaidCount %></div>
      <div class="stat-label">অপরিশোধিত নিবন্ধন</div>
    </div>
  </div>

  <!-- Charts Row -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:2rem">
    <div>
      <h2 class="report-section">আয়ের ক্যাটাগরি</h2>
      <div class="chart-container">
        <canvas id="incomeChart"></canvas>
      </div>
    </div>
    <div>
      <h2 class="report-section">খরচের ক্যাটাগরি</h2>
      <div class="chart-container">
        <canvas id="expenseChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Income by Category Table -->
  <% if (summary.incomeByCategory.length > 0) { %>
  <div class="report-section">
    <h2>আয়ের বিভাজন</h2>
    <table class="admin-table">
      <thead><tr><th>ক্যাটাগরি</th><th>পরিমাণ</th><th>শতাংশ</th></tr></thead>
      <tbody>
      <% summary.incomeByCategory.forEach(cat => { %>
        <tr>
          <td><%= cat.category || 'অন্যান্য' %></td>
          <td>€<%= cat.total.toLocaleString('en-US',{minimumFractionDigits:2}) %></td>
          <td>
            <div style="display:flex;align-items:center;gap:8px">
              <div class="bar-chart-bar" style="width:<%= Math.round(cat.pct) %>px;background:var(--success)"></div>
              <%= cat.pct.toFixed(1) %>%
            </div>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <!-- Export buttons -->
  <div style="margin-top:2rem;display:flex;gap:0.75rem;flex-wrap:wrap">
    <a href="/admin/events/<%= event.id %>/export/financial" class="btn btn-outline">Excel ডাউনলোড</a>
    <a href="/admin/events/<%= event.id %>/export/registrations" class="btn btn-outline">নিবন্ধন Excel</a>
    <a href="/admin/events/<%= event.id %>/export/incomes" class="btn btn-outline">আয় Excel</a>
    <a href="/admin/events/<%= event.id %>/export/expenses" class="btn btn-outline">খরচ Excel</a>
  </div>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
(function() {
  var incomeData = <%- JSON.stringify(summary.incomeByCategory) %>;
  var expenseData = <%- JSON.stringify(summary.expenseByCategory) %>;

  function makeChart(id, data, colorBase) {
    var ctx = document.getElementById(id);
    if (!ctx || !data.length) return;
    var colors = data.map(function(_, i) {
      var h = (i * 47 + (colorBase || 140)) % 360;
      return 'hsl(' + h + ',60%,55%)';
    });
    new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: data.map(function(d) { return d.category || 'অন্যান্য'; }),
        datasets: [{ data: data.map(function(d) { return d.total; }), backgroundColor: colors }]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
    });
  }

  makeChart('incomeChart', incomeData, 140);
  makeChart('expenseChart', expenseData, 0);
})();
</script>

<%- include('../partials/footer') %>
</body>
</html>
