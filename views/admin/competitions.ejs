<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <h1>প্রতিযোগিতা — <%= event.title %></h1>
  </div>

  <form action="/admin/events/<%= event.id %>/competitions/new" method="POST" class="admin-form" style="max-width:600px;margin-bottom:2rem">
    <h2 style="font-size:1rem;margin-bottom:1rem">নতুন প্রতিযোগিতা যোগ করুন</h2>
    <div class="form-row">
      <div class="form-group">
        <label for="name">প্রতিযোগিতার নাম *</label>
        <input type="text" id="name" name="name" required placeholder="যেমন: রবীন্দ্র সংগীত">
      </div>
      <div class="form-group">
        <label for="winner_name">বিজয়ীর নাম</label>
        <input type="text" id="winner_name" name="winner_name" placeholder="ঘোষণার আগে খালি রাখুন">
      </div>
    </div>
    <div class="form-group">
      <label for="notes">মন্তব্য</label>
      <input type="text" id="notes" name="notes" placeholder="অতিরিক্ত তথ্য (ঐচ্ছিক)">
    </div>
    <button type="submit" class="btn btn-primary">যোগ করুন</button>
  </form>

  <% if (competitions.length === 0) { %>
    <div class="empty-state"><p>এখনো কোনো প্রতিযোগিতা নেই।</p></div>
  <% } else { %>
    <table class="admin-table">
      <thead><tr>
        <th>প্রতিযোগিতার নাম</th><th>বিজয়ী</th><th>মন্তব্য</th><th>কার্যক্রম</th>
      </tr></thead>
      <tbody>
      <% competitions.forEach(comp => { %>
        <tr>
          <td><strong><%= comp.name %></strong></td>
          <td>
            <% if (comp.winner_name) { %>
              <span style="color:var(--green);font-weight:600">🏆 <%= comp.winner_name %></span>
            <% } else { %>
              <span style="color:var(--text-muted)">—</span>
            <% } %>
          </td>
          <td><%= comp.notes || '—' %></td>
          <td class="action-cell">
            <button type="button" class="btn btn-sm btn-outline edit-comp-btn"
              data-id="<%= comp.id %>"
              data-name="<%= comp.name %>"
              data-winner="<%= comp.winner_name || '' %>"
              data-notes="<%= comp.notes || '' %>">
              সম্পাদনা
            </button>
            <form action="/admin/competitions/<%= comp.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('মুছে ফেলবেন?')">
              <button type="submit" class="btn btn-sm btn-danger">মুছুন</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<!-- Edit modal -->
<div id="edit-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:500;align-items:center;justify-content:center">
  <div class="card" style="width:100%;max-width:480px;padding:1.5rem">
    <h2 style="margin:0 0 1rem;font-size:1rem">প্রতিযোগিতা সম্পাদনা</h2>
    <form id="edit-form" method="POST" class="admin-form">
      <div class="form-group">
        <label>প্রতিযোগিতার নাম *</label>
        <input type="text" id="edit-name" name="name" required>
      </div>
      <div class="form-group">
        <label>বিজয়ীর নাম</label>
        <input type="text" id="edit-winner" name="winner_name" placeholder="ঘোষণার আগে খালি রাখুন">
      </div>
      <div class="form-group">
        <label>মন্তব্য</label>
        <input type="text" id="edit-notes" name="notes">
      </div>
      <div style="display:flex;gap:0.5rem">
        <button type="submit" class="btn btn-primary">সংরক্ষণ</button>
        <button type="button" id="close-modal" class="btn btn-outline">বাতিল</button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  var modal = document.getElementById('edit-modal');
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.edit-comp-btn');
    if (btn) {
      document.getElementById('edit-form').action = '/admin/competitions/' + btn.dataset.id + '/edit';
      document.getElementById('edit-name').value = btn.dataset.name;
      document.getElementById('edit-winner').value = btn.dataset.winner;
      document.getElementById('edit-notes').value = btn.dataset.notes;
      modal.style.display = 'flex';
    }
  });
  document.getElementById('close-modal').addEventListener('click', function () {
    modal.style.display = 'none';
  });
})();
</script>

<%- include('../partials/footer') %>
</body>
</html>
