<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <div class="section-header">
    <h1><%- t('admin.pg_ads') %></h1>
    <a href="/admin/ads/new" class="btn btn-primary"><%- t('btn.new_ad') %></a>
  </div>

  <% if (ads.length === 0) { %>
    <div class="empty-state"><p><%- t('admin.empty_ads') %></p></div>
  <% } else { %>
    <table class="admin-table">
      <thead><tr>
        <th><%- t('tbl.ad') %></th><th><%- t('tbl.link') %></th><th><%- t('tbl.order') %></th><th><%- t('tbl.status') %></th><th><%- t('tbl.actions') %></th>
      </tr></thead>
      <tbody>
      <% ads.forEach(ad => { %>
        <tr>
          <td>
            <% if (ad.image_url) { %>
              <img src="<%= ad.image_url %>" alt="<%= ad.title %>" style="width:80px;height:50px;object-fit:cover;border-radius:4px;margin-bottom:4px;display:block;">
            <% } %>
            <strong><%= ad.title %></strong>
            <% const _adDesc = ad.description ? ad.description.replace(/<p><br\s*\/?><\/p>/gi,'').trim() : ''; %>
            <% if (_adDesc) { %><br><small><%- _adDesc %></small><% } %>
          </td>
          <td><% if (ad.link_url) { %><a href="<%= ad.link_url %>" target="_blank" style="word-break:break-all"><%= ad.link_url %></a><% } else { %>—<% } %></td>
          <td><%= ad.sort_order %></td>
          <td><span class="badge <%= ad.is_active ? 'badge-open' : 'badge-closed' %>"><%= ad.is_active ? t('admin.ad_active') : t('admin.ad_inactive') %></span></td>
          <td class="action-cell">
            <a href="/admin/ads/<%= ad.id %>/edit" class="btn btn-sm"><%- t('btn.edit') %></a>
            <form action="/admin/ads/<%= ad.id %>/delete" method="POST" style="display:inline" data-confirm="বিজ্ঞাপনটি মুছে ফেলবেন?">
              <button type="submit" class="btn btn-sm btn-danger"><%- t('btn.delete') %></button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
