<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <h1><%- t('admin.pg_feedback') %> — <%= event.title %></h1>
    <a href="/event/<%= event.id %>/feedback" target="_blank" class="btn btn-outline"><%- t('btn.public_form') %></a>
  </div>

  <div class="admin-form-card" style="margin-bottom:2rem">
    <h2 style="margin-bottom:1rem"><%- t('admin.add_question') %></h2>
    <form action="/admin/events/<%= event.id %>/feedback/questions" method="POST" class="admin-form">
      <div class="form-row">
        <div class="form-group">
          <label for="question"><%- t('admin.lbl_question') %></label>
          <input type="text" id="question" name="question" required placeholder="<%- t('admin.question_ph') %>">
        </div>
        <div class="form-group">
          <label for="type"><%- t('admin.lbl_type') %></label>
          <select id="type" name="type">
            <option value="rating"><%- t('admin.type_rating') %></option>
            <option value="text"><%- t('admin.type_text') %></option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-primary"><%- t('btn.add_question') %></button>
    </form>
  </div>

  <% if (results.length === 0) { %>
    <div class="empty-state"><p><%- t('admin.empty_questions') %></p></div>
  <% } else { %>
    <% results.forEach(q => { %>
      <div class="poll-result-block">
        <div class="poll-header">
          <div>
            <h3><%= q.question %></h3>
            <div class="poll-total-votes"><%= q.count %> <%- t('admin.fb_respondents') %> <%= q.type === 'rating' ? t('admin.fb_type_rating') : t('admin.fb_type_text') %></div>
          </div>
          <form action="/admin/feedback-questions/<%= q.id %>/delete" method="POST" onsubmit="return confirm('এই প্রশ্ন মুছে ফেলবেন?')">
            <button type="submit" class="btn btn-sm btn-danger"><%- t('btn.delete') %></button>
          </form>
        </div>

        <% if (q.type === 'rating' && q.avgRating) { %>
          <div class="star-display">
            <% for (let i = 1; i <= 5; i++) { %>
              <span class="<%= i <= Math.round(parseFloat(q.avgRating)) ? '' : 'empty' %>">★</span>
            <% } %>
            <strong><%= q.avgRating %> / 5</strong>
          </div>
        <% } else if (q.type === 'text' && q.texts && q.texts.length > 0) { %>
          <ul style="margin-top:0.5rem;padding-left:1.5rem">
            <% q.texts.slice(0, 10).forEach(t => { %>
              <li style="margin-bottom:0.25rem;font-size:0.9rem"><%= t %></li>
            <% }) %>
            <% if (q.texts.length > 10) { %><li style="color:var(--text-muted)"><%- t('admin.fb_more') %> <%= q.texts.length - 10 %> <%- t('admin.fb_more_suffix') %></li><% } %>
          </ul>
        <% } else { %>
          <p style="color:var(--text-muted);font-size:0.9rem"><%- t('admin.fb_no_answers') %></p>
        <% } %>
      </div>
    <% }) %>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
