<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <h1>ফিডব্যাক — <%= event.title %></h1>
    <a href="/event/<%= event.id %>/feedback" target="_blank" class="btn btn-outline">পাবলিক ফর্ম ↗</a>
  </div>

  <!-- Add question form -->
  <div class="admin-form-card" style="margin-bottom:2rem">
    <h2 style="margin-bottom:1rem">নতুন প্রশ্ন যোগ করুন</h2>
    <form action="/admin/events/<%= event.id %>/feedback/questions" method="POST" class="admin-form">
      <div class="form-row">
        <div class="form-group">
          <label for="question">প্রশ্ন *</label>
          <input type="text" id="question" name="question" required placeholder="প্রশ্নটি লিখুন">
        </div>
        <div class="form-group">
          <label for="type">ধরন</label>
          <select id="type" name="type">
            <option value="rating">রেটিং (১-৫)</option>
            <option value="text">মন্তব্য (টেক্সট)</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">প্রশ্ন যোগ করুন</button>
    </form>
  </div>

  <!-- Questions & Results -->
  <% if (results.length === 0) { %>
    <div class="empty-state"><p>এখনো কোনো প্রশ্ন নেই।</p></div>
  <% } else { %>
    <% results.forEach(q => { %>
      <div class="poll-result-block">
        <div class="poll-header">
          <div>
            <h3><%= q.question %></h3>
            <div class="poll-total-votes"><%= q.count %> জন উত্তর দিয়েছেন · ধরন: <%= q.type === 'rating' ? 'রেটিং' : 'মন্তব্য' %></div>
          </div>
          <form action="/admin/feedback-questions/<%= q.id %>/delete" method="POST" onsubmit="return confirm('এই প্রশ্ন মুছে ফেলবেন?')">
            <button type="submit" class="btn btn-sm btn-danger">মুছুন</button>
          </form>
        </div>

        <% if (q.type === 'rating' && q.avgRating) { %>
          <div class="star-display">
            <% for (let i = 1; i <= 5; i++) { %>
              <span class="<%= i <= Math.round(parseFloat(q.avgRating)) ? '' : 'empty' %>">★</span>
            <% } %>
            <strong><%= q.avgRating %> / ৫</strong>
          </div>
        <% } else if (q.type === 'text' && q.texts && q.texts.length > 0) { %>
          <ul style="margin-top:0.5rem;padding-left:1.5rem">
            <% q.texts.slice(0, 10).forEach(t => { %>
              <li style="margin-bottom:0.25rem;font-size:0.9rem"><%= t %></li>
            <% }) %>
            <% if (q.texts.length > 10) { %><li style="color:var(--text-muted)">...আরও <%= q.texts.length - 10 %> টি</li><% } %>
          </ul>
        <% } else { %>
          <p style="color:var(--text-muted);font-size:0.9rem">এখনো কোনো উত্তর নেই।</p>
        <% } %>
      </div>
    <% }) %>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
