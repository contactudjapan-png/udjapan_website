<%- include('../partials/head') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>
<% var _dateLocale = locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-GB' : 'bn-BD'; %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <h1><%- t('admin.pg_reports') %> — <%= event.title %></h1>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-number"><%= report.totalRegistrations %></div>
      <div class="stat-label"><%- t('admin.stat_registrations') %></div>
    </div>
    <div class="stat-card">
      <div class="stat-number"><%= report.paidCount %></div>
      <div class="stat-label"><%- t('admin.stat_paid') %></div>
    </div>
    <div class="stat-card">
      <div class="stat-number"><%= report.unpaidCount %></div>
      <div class="stat-label"><%- t('admin.stat_unpaid') %></div>
    </div>
    <div class="stat-card" style="color:var(--success)">
      <div class="stat-number">€<%= financial.totalIncome.toLocaleString('en-US', {minimumFractionDigits:2}) %></div>
      <div class="stat-label">Total Income</div>
    </div>
    <div class="stat-card" style="color:var(--danger)">
      <div class="stat-number">€<%= financial.totalExpenses.toLocaleString('en-US', {minimumFractionDigits:2}) %></div>
      <div class="stat-label"><%- t('admin.stat_total_exp') %></div>
    </div>
    <div class="stat-card" style="<%= financial.netProfit >= 0 ? 'color:var(--success)' : 'color:var(--danger)' %>">
      <div class="stat-number">€<%= financial.netProfit.toLocaleString('en-US', {minimumFractionDigits:2}) %></div>
      <div class="stat-label">Net Profit</div>
    </div>
    <div class="stat-card">
      <div class="stat-number"><%= report.pendingSubmissions %></div>
      <div class="stat-label"><%- t('admin.stat_pending_subs') %></div>
    </div>
    <div class="stat-card">
      <div class="stat-number"><%= report.volunteerStats.approved %> / <%= report.volunteerStats.total %></div>
      <div class="stat-label"><%- t('admin.stat_approved_vols') %></div>
    </div>
  </div>

  <% if (report.suggestions.length > 0) { %>
  <div class="report-section">
    <h2><%- t('admin.suggestions') %></h2>
    <ul class="suggestion-list">
      <% report.suggestions.forEach(s => { %>
        <li><%= s %></li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <div class="report-section">
    <h2>Income &amp; Expense Overview</h2>
    <div class="charts-row" style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:start">
      <div>
        <h3 style="font-size:1rem;margin-bottom:0.75rem">Income by Category</h3>
        <% if (financial.incomeByCategory.length > 0) { %>
          <div class="chart-container" style="max-height:280px"><canvas id="incomePieChart"></canvas></div>
          <table class="admin-table" style="margin-top:1rem;font-size:0.85rem">
            <thead><tr><th>Category</th><th>Amount</th><th>%</th></tr></thead>
            <tbody>
            <% financial.incomeByCategory.forEach(c => { %>
              <tr><td><%= c.category %></td><td>€<%= c.total.toFixed(2) %></td><td><%= c.pct.toFixed(1) %>%</td></tr>
            <% }) %>
              <tr class="total-row"><td><strong>Total</strong></td><td><strong>€<%= financial.totalIncome.toFixed(2) %></strong></td><td></td></tr>
            </tbody>
          </table>
        <% } else { %>
          <div class="empty-state"><p>No income recorded yet.</p></div>
        <% } %>
      </div>
      <div>
        <h3 style="font-size:1rem;margin-bottom:0.75rem">Expenses by Category</h3>
        <% if (financial.expenseByCategory.length > 0) { %>
          <div class="chart-container" style="max-height:280px"><canvas id="expensePieChart"></canvas></div>
          <table class="admin-table" style="margin-top:1rem;font-size:0.85rem">
            <thead><tr><th>Category</th><th>Amount</th><th>%</th></tr></thead>
            <tbody>
            <% financial.expenseByCategory.forEach(c => { %>
              <tr><td><%= c.category %></td><td>€<%= c.total.toFixed(2) %></td><td><%= c.pct.toFixed(1) %>%</td></tr>
            <% }) %>
              <tr class="total-row"><td><strong>Total</strong></td><td><strong>€<%= financial.totalExpenses.toFixed(2) %></strong></td><td></td></tr>
            </tbody>
          </table>
        <% } else { %>
          <div class="empty-state"><p>No expenses recorded yet.</p></div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="report-section">
    <h2>Income by Date</h2>
    <% if (incomeByDate.length === 0) { %>
      <div class="empty-state"><p>No income entries yet.</p></div>
    <% } else { %>
      <table class="admin-table">
        <thead><tr><th>Date</th><th>Entries</th><th>Total</th></tr></thead>
        <tbody>
        <% let _incomeGrandTotal = 0; %>
        <% incomeByDate.forEach(row => { _incomeGrandTotal += row.total; %>
          <tr>
            <td><%= new Date(row.date + 'T12:00:00Z').toLocaleDateString('de-DE') %></td>
            <td><%= row.count %></td>
            <td>€<%= row.total.toFixed(2) %></td>
          </tr>
        <% }) %>
          <tr class="total-row">
            <td><strong>Total</strong></td>
            <td><strong><%= financial.incomes.length %></strong></td>
            <td><strong>€<%= _incomeGrandTotal.toFixed(2) %></strong></td>
          </tr>
        </tbody>
      </table>

      <h3 style="margin-top:1.5rem;font-size:1rem">Income Detail</h3>
      <table class="admin-table" style="font-size:0.85rem">
        <thead><tr><th>Date</th><th>Description</th><th>Payer</th><th>Transaction ID</th><th>Amount</th></tr></thead>
        <tbody>
        <% financial.incomes.slice().sort((a,b) => (b.payment_date||b.created_at).localeCompare(a.payment_date||a.created_at)).forEach(inc => { %>
          <tr>
            <td style="white-space:nowrap"><%= new Date((inc.payment_date || inc.created_at).substring(0,10) + 'T12:00:00Z').toLocaleDateString('de-DE') %></td>
            <td><%= inc.description || inc.category || '—' %></td>
            <td><%= inc.payer_name || inc.payer_email || '—' %></td>
            <td style="font-size:0.78rem"><%= inc.transaction_id || '—' %></td>
            <td style="white-space:nowrap">€<%= parseFloat(inc.amount).toFixed(2) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="report-section">
    <h2><%- t('admin.reg_trend') %></h2>
    <% if (report.registrationByDate.length === 0) { %>
      <div class="empty-state"><p><%- t('admin.empty_reg_trend') %></p></div>
    <% } else { %>
      <div class="chart-container">
        <canvas id="regChart"></canvas>
      </div>
      <p class="chart-hint"><%- t('admin.chart_reg_hint') %></p>
    <% } %>
  </div>

  <div class="report-section">
    <h2><%- t('admin.expense_trend') %></h2>
    <% if (report.expenseByDate.length === 0) { %>
      <div class="empty-state"><p><%- t('admin.empty_exp_trend') %></p></div>
    <% } else { %>
      <div class="chart-container">
        <canvas id="expChart"></canvas>
      </div>
      <p class="chart-hint"><%- t('admin.chart_exp_hint') %></p>
    <% } %>
  </div>

  <div class="report-section">
    <h2><%- t('admin.registered_participants') %></h2>
    <% if (report.registrations.length === 0) { %>
      <div class="empty-state"><p><%- t('admin.empty_participants') %></p></div>
    <% } else { %>
      <table class="admin-table">
        <thead><tr>
          <th>#</th><th><%- t('tbl.name') %></th><th><%- t('tbl.email') %></th><th><%- t('tbl.pay_ref') %></th><th><%- t('tbl.status') %></th><th><%- t('admin.tbl_reg_date') %></th>
        </tr></thead>
        <tbody>
        <% report.registrations.forEach((reg, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><strong><%= reg.name %></strong></td>
            <td><%= reg.email %></td>
            <td><%= reg.payment_reference || '—' %></td>
            <td><span class="badge <%= reg.is_paid ? 'badge-paid' : 'badge-pending' %>"><%= reg.is_paid ? t('admin.status_paid') : t('admin.status_pending') %></span></td>
            <td><%= new Date(reg.created_at).toLocaleDateString(_dateLocale, { timeZone: 'Europe/Berlin' }) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="report-section">
    <h2><%- t('admin.section_expenses') %></h2>
    <% if (report.expenses.length === 0) { %>
      <div class="empty-state"><p><%- t('admin.empty_expenses2') %></p></div>
    <% } else { %>
      <table class="admin-table">
        <thead><tr><th><%- t('tbl.description') %></th><th><%- t('tbl.amount') %></th><th><%- t('tbl.date') %></th></tr></thead>
        <tbody>
        <% report.expenses.forEach(exp => { %>
          <tr>
            <td><%= exp.description %></td>
            <td>€<%= parseFloat(exp.amount).toLocaleString('en-US', {minimumFractionDigits:2}) %></td>
            <td><%= new Date(exp.created_at).toLocaleDateString(_dateLocale, { timeZone: 'Europe/Berlin' }) %></td>
          </tr>
        <% }) %>
          <tr class="total-row">
            <td><strong><%- t('admin.total_label') %></strong></td>
            <td><strong>€<%= report.totalExpenses.toLocaleString('en-US', {minimumFractionDigits:2}) %></strong></td>
            <td></td>
          </tr>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="report-section">
    <h2><%- t('admin.section_volunteers') %></h2>
    <div class="stats-grid stats-grid-sm">
      <div class="stat-card"><div class="stat-number"><%= report.volunteerStats.total %></div><div class="stat-label"><%- t('admin.vol_total') %></div></div>
      <div class="stat-card"><div class="stat-number"><%= report.volunteerStats.approved %></div><div class="stat-label"><%- t('admin.vol_approved') %></div></div>
      <div class="stat-card"><div class="stat-number"><%= report.volunteerStats.pending %></div><div class="stat-label"><%- t('admin.vol_pending') %></div></div>
      <div class="stat-card"><div class="stat-number"><%= report.volunteerStats.rejected %></div><div class="stat-label"><%- t('admin.vol_rejected') %></div></div>
    </div>
  </div>

  <div class="report-section">
    <h2><%- t('admin.attendance') %></h2>
    <div class="stats-grid stats-grid-sm">
      <div class="stat-card"><div class="stat-number"><%= attendance.checkedIn %></div><div class="stat-label"><%- t('admin.att_checked_in') %></div></div>
      <div class="stat-card"><div class="stat-number"><%= attendance.noShow %></div><div class="stat-label"><%- t('admin.att_no_show') %></div></div>
      <div class="stat-card"><div class="stat-number"><%= attendance.rate %>%</div><div class="stat-label"><%- t('admin.att_rate') %></div></div>
      <div class="stat-card"><div class="stat-number"><%= attendance.totalScans %></div><div class="stat-label"><%- t('admin.att_total_scans') %></div></div>
    </div>
    <% if (attendance.totalScans > 0) { %>
      <div class="chart-container" style="margin-top:1rem">
        <canvas id="attendanceChart"></canvas>
      </div>
      <p class="chart-hint"><%- t('admin.att_chart_hint') %></p>
    <% } %>
  </div>

  <% if (report.pollResults.length > 0) { %>
  <div class="report-section">
    <h2><%- t('admin.poll_results') %></h2>
    <% report.pollResults.forEach(poll => { %>
      <div class="poll-result-block">
        <h3><%= poll.question %> <small class="badge <%= poll.is_active ? 'badge-open' : 'badge-closed' %>"><%= poll.is_active ? t('admin.poll_status_active') : t('admin.poll_status_closed') %></small></h3>
        <p class="poll-total-votes"><%- t('admin.total_votes') %> <%= poll.totalVotes %></p>
        <% poll.options.forEach(opt => { %>
          <div class="poll-option-bar">
            <span class="poll-opt-label"><%= opt.option_text %></span>
            <div class="poll-bar-track">
              <div class="poll-bar-fill" style="width: <%= opt.pct %>%"></div>
            </div>
            <span class="poll-opt-count"><%= opt.vote_count %> (<%= opt.pct %>%)</span>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
  <% } %>

</main>

<%- include('../partials/footer') %>

<script>
(function() {
  const PIE_COLORS = ['#4f86f7','#27ae60','#e74c3c','#f39c12','#9b59b6','#1abc9c','#e67e22','#2c3e50','#16a085','#c0392b'];

  <% if (financial.incomeByCategory.length > 0) { %>
  new Chart(document.getElementById('incomePieChart'), {
    type: 'pie',
    data: {
      labels: <%- JSON.stringify(financial.incomeByCategory.map(c => c.category)) %>,
      datasets: [{ data: <%- JSON.stringify(financial.incomeByCategory.map(c => c.total)) %>, backgroundColor: PIE_COLORS }],
    },
    options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } } },
  });
  <% } %>

  <% if (financial.expenseByCategory.length > 0) { %>
  new Chart(document.getElementById('expensePieChart'), {
    type: 'pie',
    data: {
      labels: <%- JSON.stringify(financial.expenseByCategory.map(c => c.category)) %>,
      datasets: [{ data: <%- JSON.stringify(financial.expenseByCategory.map(c => c.total)) %>, backgroundColor: PIE_COLORS.slice().reverse() }],
    },
    options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } } },
  });
  <% } %>

  <% if (report.registrationByDate.length > 0) { %>
  const regLabels = <%- JSON.stringify(report.registrationByDate.map(r => r.date)) %>;
  const regValues = <%- JSON.stringify(report.registrationByDate.map(r => r.count)) %>;
  const regMA    = <%- JSON.stringify(report.regMovingAvg.map(r => r.avg)) %>;
  const regFcLabels = <%- JSON.stringify(report.regForecast.map(r => r.date)) %>;
  const regFcValues = <%- JSON.stringify(report.regForecast.map(r => r.value)) %>;

  const allRegLabels = [...regLabels, ...regFcLabels];
  const regBarData   = [...regValues, ...new Array(regFcLabels.length).fill(null)];
  const regMAData    = [...regMA,     ...new Array(regFcLabels.length).fill(null)];
  const regFcData    = [...new Array(regLabels.length - 1).fill(null), regMA[regMA.length - 1], ...regFcValues];

  new Chart(document.getElementById('regChart'), {
    data: {
      labels: allRegLabels,
      datasets: [
        { type: 'bar',  label: '<%= t("admin.stat_registrations") %>', data: regBarData, backgroundColor: 'rgba(79,134,247,0.6)', borderColor: '#4f86f7', borderWidth: 1 },
        { type: 'line', label: '3-MA', data: regMAData, borderColor: '#f7a04f', borderWidth: 2, pointRadius: 3, fill: false, tension: 0.3 },
        { type: 'line', label: 'Forecast', data: regFcData, borderColor: '#e74c3c', borderWidth: 2, borderDash: [6,4], pointRadius: 3, fill: false, tension: 0.3 },
      ],
    },
    options: { responsive: true, plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } },
  });
  <% } %>

  <% if (attendance.totalScans > 0) { %>
  new Chart(document.getElementById('attendanceChart'), {
    type: 'bar',
    data: {
      labels: <%- JSON.stringify(attendance.byHour.map(h => h.hour + ':00')) %>,
      datasets: [{ label: '<%= t("admin.att_checked_in") %>', data: <%- JSON.stringify(attendance.byHour.map(h => h.count)) %>, backgroundColor: 'rgba(79,134,247,0.6)', borderColor: '#4f86f7', borderWidth: 1 }],
    },
    options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } },
  });
  <% } %>

  <% if (report.expenseByDate.length > 0) { %>
  const expLabels = <%- JSON.stringify(report.expenseByDate.map(e => e.date)) %>;
  const expValues = <%- JSON.stringify(report.expenseByDate.map(e => e.amount)) %>;
  const expMA    = <%- JSON.stringify(report.expMovingAvg.map(e => e.avg)) %>;
  const expFcLabels = <%- JSON.stringify(report.expForecast.map(e => e.date)) %>;
  const expFcValues = <%- JSON.stringify(report.expForecast.map(e => e.value)) %>;

  const allExpLabels = [...expLabels, ...expFcLabels];
  const expBarData   = [...expValues, ...new Array(expFcLabels.length).fill(null)];
  const expMAData    = [...expMA,     ...new Array(expFcLabels.length).fill(null)];
  const expFcData    = [...new Array(expLabels.length - 1).fill(null), expMA[expMA.length - 1], ...expFcValues];

  new Chart(document.getElementById('expChart'), {
    data: {
      labels: allExpLabels,
      datasets: [
        { type: 'bar',  label: '<%= t("admin.section_expenses") %> (€)', data: expBarData, backgroundColor: 'rgba(231,76,60,0.5)', borderColor: '#e74c3c', borderWidth: 1 },
        { type: 'line', label: '3-MA', data: expMAData, borderColor: '#9b59b6', borderWidth: 2, pointRadius: 3, fill: false, tension: 0.3 },
        { type: 'line', label: 'Forecast', data: expFcData, borderColor: '#e67e22', borderWidth: 2, borderDash: [6,4], pointRadius: 3, fill: false, tension: 0.3 },
      ],
    },
    options: { responsive: true, plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: true } } },
  });
  <% } %>
})();
</script>
</body>
</html>
