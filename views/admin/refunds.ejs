<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>
<% var _dateLocale = locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-GB' : 'bn-BD'; %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <h1><%- t('admin.pg_refunds') %> — <%= event.title %></h1>
    <a href="/admin/events/<%= event.id %>/refunds/new" class="btn btn-primary"><%- t('btn.add_refund') %></a>
  </div>

  <div class="total-banner"><%- t('admin.total_refund') %> <strong>€<%= total.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) %></strong></div>

  <% if (refunds.length === 0) { %>
    <div class="empty-state"><p><%- t('admin.empty_refunds') %></p></div>
  <% } else { %>
    <table class="admin-table">
      <thead><tr>
        <th><%- t('tbl.amount') %></th><th><%- t('tbl.reason') %></th><th><%- t('tbl.transaction_id') %></th><th><%- t('tbl.date') %></th><th><%- t('tbl.actions') %></th>
      </tr></thead>
      <tbody>
      <% refunds.forEach(r => { %>
        <tr>
          <td style="color:var(--danger);font-weight:600">-€<%= parseFloat(r.amount).toLocaleString('en-US', {minimumFractionDigits:2}) %></td>
          <td><%= r.reason || '—' %></td>
          <td><% if (r.transaction_id) { %><code><%= r.transaction_id %></code><% } else { %>—<% } %></td>
          <td><%= new Date(r.created_at).toLocaleDateString(_dateLocale, { timeZone: 'Europe/Berlin' }) %></td>
          <td>
            <form action="/admin/refunds/<%= r.id %>/delete" method="POST" onsubmit="return confirm('এই রিফান্ড মুছে ফেলবেন?')">
              <button type="submit" class="btn btn-sm btn-danger"><%- t('btn.delete') %></button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
