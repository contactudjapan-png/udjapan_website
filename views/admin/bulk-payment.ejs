<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <h1><%- t('admin.pg_bulk_payment') %> — <%= event.title %></h1>

  <div class="info-box">
    <strong><%- t('bulk.csv_format') %></strong>
    Required columns: <code>name</code>, <code>email or phone</code>, <code>transaction_id</code>, <code>amount</code>, <code>date</code> (DD/MM/YYYY)<br>
    Matching order: email → phone → transaction reference → name
  </div>

  <div class="admin-form-card" style="margin-bottom:2rem">
    <form action="/admin/events/<%= event.id %>/bulk-payment" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label for="payment_file"><%- t('bulk.lbl_payment_file') %></label>
        <input type="file" id="payment_file" name="payment_file" accept=".csv,.xlsx,.xls" required>
      </div>
      <button type="submit" class="btn btn-primary"><%- t('btn.process') %></button>
    </form>
  </div>

  <% if (locals.results) { %>
    <div class="report-section">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number" style="color:var(--success)"><%= results.matched.length %></div>
          <div class="stat-label"><%- t('bulk.stat_paid') %></div>
        </div>
        <div class="stat-card">
          <div class="stat-number" style="color:var(--warning)"><%= results.alreadyPaid.length %></div>
          <div class="stat-label"><%- t('bulk.stat_already_paid') %></div>
        </div>
        <div class="stat-card">
          <div class="stat-number" style="color:var(--danger)"><%= results.notFound.length %></div>
          <div class="stat-label"><%- t('bulk.stat_not_found') %></div>
        </div>
      </div>

      <% if (results.matched.length > 0) { %>
        <h2 style="margin-top:1.5rem"><%- t('bulk.section_paid') %> (<%= results.matched.length %>)</h2>
        <table class="admin-table">
          <thead><tr>
            <th><%- t('tbl.name') %></th>
            <th>Contact</th>
            <th><%- t('tbl.transaction_id') %></th>
            <th>Date</th>
            <th>Tier</th>
            <th>Paid</th>
            <th>Expected</th>
            <th>Check</th>
          </tr></thead>
          <tbody>
          <% results.matched.forEach(r => { %>
            <tr>
              <td><%= r.name %></td>
              <td><%= r.email || r.phone || '—' %></td>
              <td><%= r.transaction_id || '—' %></td>
              <td><%= r.date ? new Date(r.date).toLocaleDateString('de-DE', { timeZone: 'Europe/Berlin' }) : '—' %></td>
              <td><%= r.tier || '—' %></td>
              <td><% if (r.amount != null) { %>€<%= parseFloat(r.amount).toFixed(2) %><% } else { %>—<% } %></td>
              <td>
                <% if (r.expected_amount != null) { %>
                  €<%= parseFloat(r.expected_amount).toFixed(2) %>
                  <span style="color:var(--text-muted);font-size:0.8rem">(<%= r.adults_count %>×)</span>
                <% } else { %>—<% } %>
              </td>
              <td>
                <% if (r.expected_amount == null || r.amount == null) { %>
                  <span style="color:var(--text-muted)">—</span>
                <% } else if (r.amount_mismatch) { %>
                  <span style="color:var(--danger);font-weight:600">⚠ Mismatch</span>
                <% } else { %>
                  <span style="color:var(--success);font-weight:600">✓</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      <% } %>

      <% if (results.notFound.length > 0) { %>
        <h2 style="margin-top:1.5rem;color:var(--danger)"><%- t('bulk.section_not_found') %> (<%= results.notFound.length %>)</h2>
        <table class="admin-table">
          <thead><tr><th><%- t('tbl.name') %></th><th><%- t('tbl.email') %></th><th>Phone</th><th><%- t('tbl.transaction_id') %></th></tr></thead>
          <tbody>
          <% results.notFound.forEach(r => { %>
            <tr><td><%= r.name || '—' %></td><td><%= r.email || '—' %></td><td><%= r.phone || '—' %></td><td><%= r.transaction_id || '—' %></td></tr>
          <% }) %>
          </tbody>
        </table>
      <% } %>

      <% if (results.alreadyPaid.length > 0) { %>
        <h2 style="margin-top:1.5rem;color:var(--warning)"><%- t('bulk.section_skipped') %> (<%= results.alreadyPaid.length %>)</h2>
        <table class="admin-table">
          <thead><tr><th><%- t('tbl.name') %></th><th><%- t('tbl.email') %></th><th><%- t('tbl.reason') %></th></tr></thead>
          <tbody>
          <% results.alreadyPaid.forEach(r => { %>
            <tr><td><%= r.name || '—' %></td><td><%= r.email || '—' %></td><td><%= r.reason %></td></tr>
          <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
