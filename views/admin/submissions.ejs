<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>
<% var _dateLocale = locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-GB' : 'bn-BD'; %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <h1><%- t('admin.pg_submissions') %> — <%= event.title %></h1>
  </div>

  <% if (submissions.length === 0) { %>
    <div class="empty-state"><p><%- t('admin.empty_submissions') %></p></div>
  <% } else { %>
    <table class="admin-table">
      <thead><tr>
        <th><%- t('tbl.name') %></th><th><%- t('admin.tbl_contact') %></th><th><%- t('admin.tbl_adults') %></th><th><%- t('admin.tbl_children') %></th><th><%- t('admin.tbl_pay_ref') %></th><th><%- t('tbl.date') %></th><th><%- t('tbl.actions') %></th>
      </tr></thead>
      <tbody>
      <% submissions.forEach(sub => { %>
        <tr>
          <td>
            <strong><%= sub.name %></strong>
            <% if (sub.is_special_needs) { %><span class="badge-special" title="<%- t('reg.special_needs') %>">♿</span><% } %>
          </td>
          <td><%= sub.email %></td>
          <td><%= sub.adults_count || 0 %></td>
          <td><%= sub.children_count || 0 %></td>

          <td><%= sub.payment_reference || '—' %></td>
          <td><%= new Date(sub.created_at).toLocaleDateString(_dateLocale, { timeZone: 'Europe/Berlin' }) %></td>
          <td class="action-cell">
            <form action="/admin/submissions/<%= sub.id %>/approve" method="POST" style="display:inline" data-confirm="<%= sub.name %>-এর জন্য নিবন্ধন অনুমোদন করবেন?">
              <button type="submit" class="btn btn-sm btn-success"><%- t('btn.approve') %></button>
            </form>
            <form action="/admin/submissions/<%= sub.id %>/delete" method="POST" style="display:inline" data-confirm="এই সাবমিশন মুছে ফেলবেন?">
              <button type="submit" class="btn btn-sm btn-danger"><%- t('btn.delete') %></button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
