<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <h1><%- t('admin.pg_stalls') %> — <%= event.title %></h1>
    <a href="/admin/events/<%= event.id %>/stalls/new" class="btn btn-primary"><%- t('btn.new_stall') %></a>
  </div>

  <% if (stalls.length === 0) { %>
    <div class="empty-state"><p><%- t('admin.empty_stalls') %></p></div>
  <% } else { %>
    <div class="stalls-summary">
      <span><strong><%= stalls.length %></strong> <%- t('admin.total') %></span>
      <span><strong><%= stalls.filter(s=>s.is_occupied).length %></strong> <%- t('admin.stalls_occupied') %></span>
      <span><strong><%= stalls.filter(s=>!s.is_occupied).length %></strong> <%- t('admin.stalls_free') %></span>
    </div>
    <table class="admin-table">
      <thead><tr>
        <th><%- t('tbl.stall_name') %></th><th><%- t('tbl.location') %></th><th><%- t('tbl.assigned') %></th><th><%- t('tbl.fee') %></th><th><%- t('tbl.status') %></th><th><%- t('tbl.actions') %></th>
      </tr></thead>
      <tbody>
      <% stalls.forEach(stall => { %>
        <tr>
          <td><strong><%= stall.stall_name %></strong><% if(stall.description) { %><br><small><%- stall.description %></small><% } %></td>
          <td><%= stall.location_info || '—' %></td>
          <td>
            <% if (stall.assigned_to_name) { %>
              <%= stall.assigned_to_name %>
              <% if (stall.assigned_to_email) { %><br><small><%= stall.assigned_to_email %></small><% } %>
              <% if (stall.assigned_to_phone) { %><br><small><%= stall.assigned_to_phone %></small><% } %>
            <% } else { %>—<% } %>
          </td>
          <td><% if (stall.fee) { %>€<%= parseFloat(stall.fee).toFixed(2) %><% } else { %>—<% } %></td>
          <td><span class="badge <%= stall.is_occupied ? 'badge-closed' : 'badge-open' %>"><%= stall.is_occupied ? t('admin.stall_occupied') : t('admin.stall_free') %></span></td>
          <td class="action-cell">
            <button class="btn btn-sm obs-btn"
              data-name="<%= stall.stall_name %>"
              data-id="<%= stall.id %>">
              <%- t('admin.observation') %> (<%= stall.observations ? stall.observations.length : 0 %>)
            </button>
            <script type="application/json" id="obs-<%= stall.id %>"><%- JSON.stringify(stall.observations || []) %></script>
            <a href="/admin/stalls/<%= stall.id %>/edit" class="btn btn-sm"><%- t('admin.edit_assign') %></a>
            <form action="/admin/stalls/<%= stall.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('এই স্টল মুছে ফেলবেন?')">
              <button type="submit" class="btn btn-sm btn-danger"><%- t('btn.delete') %></button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<!-- Observations modal -->
<div id="obs-backdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;padding:2rem;overflow-y:auto">
  <div style="background:#fff;border-radius:8px;max-width:780px;margin:0 auto;padding:1.5rem">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
      <h2 id="obs-title" style="margin:0"></h2>
      <button id="obs-close" class="btn btn-outline" style="padding:0.2rem 0.6rem;font-size:1.1rem">&times;</button>
    </div>
    <div id="obs-body"></div>
  </div>
</div>

<script src="/js/stall-obs-modal.js"></script>

<%- include('../partials/footer') %>
</body>
</html>
