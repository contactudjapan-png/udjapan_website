<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <h1><%- t('admin.pg_volunteer_tasks') %></h1>
  <p style="color:var(--text-muted);margin-bottom:1.5rem"><%- t('admin.vol_tasks_hint') %></p>

  <form action="/admin/settings/volunteer-tasks" method="POST" class="admin-form" style="max-width:680px">
    <div id="task-list" style="display:flex;flex-direction:column;gap:0.5rem;margin-bottom:1rem">
      <% if (tasks.length === 0) { %>
        <div class="task-row" style="display:flex;gap:0.5rem;align-items:center">
          <input type="text" name="task_name" placeholder="<%- t('admin.task_name_ph') %>" class="inline-input" style="flex:1">
          <select name="task_role" class="inline-input" style="width:220px">
            <option value="stall"><%- t('admin.vt_stall') %></option>
            <option value="reg"><%- t('admin.vt_reg') %></option>
            <option value="qr"><%- t('admin.vt_qr') %></option>
            <option value="music"><%- t('admin.vt_music') %></option>
            <option value="competition"><%- t('admin.vt_competition') %></option>
            <option value="anchor"><%- t('admin.vt_anchor') %></option>
            <option value="performer"><%- t('admin.vt_performer') %></option>
            <option value="controlRoom"><%- t('admin.vt_control_room') %></option>
          </select>
          <button type="button" class="btn btn-sm btn-danger remove-row" style="flex-shrink:0">&times;</button>
        </div>
      <% } else { %>
        <% tasks.forEach(task => { %>
          <div class="task-row" style="display:flex;gap:0.5rem;align-items:center">
            <input type="text" name="task_name" value="<%= task.name %>" placeholder="<%- t('admin.task_name_ph') %>" class="inline-input" style="flex:1">
            <select name="task_role" class="inline-input" style="width:220px">
              <option value="stall" <%= task.role === 'stall' ? 'selected' : '' %>><%- t('admin.vt_stall') %></option>
              <option value="reg" <%= task.role === 'reg' ? 'selected' : '' %>><%- t('admin.vt_reg') %></option>
              <option value="qr" <%= task.role === 'qr' ? 'selected' : '' %>><%- t('admin.vt_qr') %></option>
              <option value="music" <%= task.role === 'music' ? 'selected' : '' %>><%- t('admin.vt_music') %></option>
              <option value="competition" <%= task.role === 'competition' ? 'selected' : '' %>><%- t('admin.vt_competition') %></option>
              <option value="anchor" <%= task.role === 'anchor' ? 'selected' : '' %>><%- t('admin.vt_anchor') %></option>
              <option value="performer" <%= task.role === 'performer' ? 'selected' : '' %>><%- t('admin.vt_performer') %></option>
              <option value="controlRoom" <%= task.role === 'controlRoom' ? 'selected' : '' %>><%- t('admin.vt_control_room') %></option>
            </select>
            <button type="button" class="btn btn-sm btn-danger remove-row" style="flex-shrink:0">&times;</button>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div style="margin-bottom:1.5rem">
      <button type="button" id="add-task" class="btn btn-outline btn-sm"><%- t('btn.add_task') %></button>
    </div>

    <button type="submit" class="btn btn-primary"><%- t('btn.save') %></button>
  </form>
</main>

<script>
(function () {
  const list = document.getElementById('task-list');
  const roleOptions = [
    ['stall', '<%= t("admin.vt_stall") %>'],
    ['reg', '<%= t("admin.vt_reg") %>'],
    ['qr', '<%= t("admin.vt_qr") %>'],
    ['music', '<%= t("admin.vt_music") %>'],
    ['competition', '<%= t("admin.vt_competition") %>'],
    ['anchor', '<%= t("admin.vt_anchor") %>'],
    ['performer', '<%= t("admin.vt_performer") %>'],
    ['controlRoom', '<%= t("admin.vt_control_room") %>'],
  ].map(([v, l]) => '<option value="' + v + '">' + l + '</option>').join('');

  list.addEventListener('click', function (e) {
    if (!e.target.classList.contains('remove-row')) return;
    const row = e.target.closest('.task-row');
    if (list.querySelectorAll('.task-row').length > 1) row.remove();
    else row.querySelector('input').value = '';
  });

  document.getElementById('add-task').addEventListener('click', function () {
    const row = document.createElement('div');
    row.className = 'task-row';
    row.style.cssText = 'display:flex;gap:0.5rem;align-items:center';
    row.innerHTML =
      '<input type="text" name="task_name" placeholder="<%= t("admin.task_name_ph") %>" class="inline-input" style="flex:1">' +
      '<select name="task_role" class="inline-input" style="width:220px">' + roleOptions + '</select>' +
      '<button type="button" class="btn btn-sm btn-danger remove-row" style="flex-shrink:0">\u00d7</button>';
    list.appendChild(row);
    row.querySelector('input').focus();
  });
})();
</script>

<%- include('../partials/footer') %>
</body>
</html>
