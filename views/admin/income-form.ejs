<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <h1>আয় যোগ করুন — <%= event.title %></h1>

  <form action="/admin/events/<%= event.id %>/incomes/new" method="POST" class="admin-form">
    <div class="form-group">
      <label for="category">ক্যাটাগরি</label>
      <select id="category" name="category">
        <option value="">— বেছে নিন —</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat %>"><%= cat %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label for="description">বিবরণ</label>
      <input type="text" id="description" name="description" placeholder="আয়ের বিবরণ">
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="amount">পরিমাণ (€) *</label>
        <input type="number" id="amount" name="amount" step="0.01" min="0" required>
      </div>
      <div class="form-group">
        <label for="payment_date">পেমেন্টের তারিখ ও সময়</label>
        <input type="datetime-local" id="payment_date" name="payment_date">
      </div>
    </div>
    <div class="form-group">
      <label for="transaction_id">লেনদেন আইডি</label>
      <input type="text" id="transaction_id" name="transaction_id" placeholder="ব্যাংক/পেমেন্ট রেফারেন্স">
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="payer_name">প্রদানকারীর নাম</label>
        <input type="text" id="payer_name" name="payer_name">
      </div>
      <div class="form-group">
        <label for="payer_email">প্রদানকারীর ইমেইল</label>
        <input type="email" id="payer_email" name="payer_email">
      </div>
    </div>
    <button type="submit" class="btn btn-primary">আয় সংরক্ষণ করুন</button>
    <a href="/admin/events/<%= event.id %>/incomes" class="btn btn-outline">বাতিল</a>
  </form>
</main>

<%- include('../partials/footer') %>
</body>
</html>
