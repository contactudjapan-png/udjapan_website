<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <h1><%- t('admin.pg_add_income') %> — <%= event.title %></h1>

  <form action="/admin/events/<%= event.id %>/incomes/new" method="POST" class="admin-form">
    <div class="form-group">
      <label for="category"><%- t('admin.lbl_category') %></label>
      <select id="category" name="category">
        <option value=""><%- t('admin.select_income_cat') %></option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat %>"><%= cat %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label for="description"><%- t('admin.lbl_description') %></label>
      <input type="text" id="description" name="description" placeholder="<%- t('admin.lbl_description') %>">
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="amount"><%- t('admin.lbl_amount_opt') %></label>
        <input type="number" id="amount" name="amount" step="0.01" min="0" required>
      </div>
      <div class="form-group">
        <label for="payment_date"><%- t('admin.lbl_payment_date') %></label>
        <input type="datetime-local" id="payment_date" name="payment_date">
      </div>
    </div>
    <div class="form-group">
      <label for="transaction_id"><%- t('admin.lbl_transaction_id') %></label>
      <input type="text" id="transaction_id" name="transaction_id" placeholder="<%- t('admin.lbl_transaction_id') %>">
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="payer_name"><%- t('admin.lbl_payer_name') %></label>
        <input type="text" id="payer_name" name="payer_name">
      </div>
      <div class="form-group">
        <label for="payer_email"><%- t('admin.lbl_payer_email') %></label>
        <input type="email" id="payer_email" name="payer_email">
      </div>
    </div>
    <button type="submit" class="btn btn-primary"><%- t('admin.btn_save_income') %></button>
    <a href="/admin/events/<%= event.id %>/incomes" class="btn btn-outline"><%- t('btn.cancel') %></a>
  </form>
</main>

<%- include('../partials/footer') %>
</body>
</html>
