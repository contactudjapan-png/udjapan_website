<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <h1><%- t('admin.pg_stall_obs_types') %></h1>
  <p style="color:var(--text-muted)"><%- t('admin.stall_obs_hint') %></p>

  <form action="/admin/settings/stall-obs-types" method="POST" class="admin-form" style="max-width:480px">
    <div class="form-group">
      <label for="stall_obs_types"><%- t('admin.lbl_obs_types') %></label>
      <textarea id="stall_obs_types" name="stall_obs_types" rows="10"><%= stallObsTypes %></textarea>
    </div>
    <button type="submit" class="btn btn-primary"><%- t('btn.save') %></button>
  </form>
</main>

<%- include('../partials/footer') %>
</body>
</html>
