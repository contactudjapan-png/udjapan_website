<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <div>
      <h1>পর্যবেক্ষণ — <%= stall.stall_name %></h1>
      <p style="margin:0;color:var(--text-muted)"><%= event.title %><% if (stall.location_info) { %> &mdash; <%= stall.location_info %><% } %></p>
    </div>
    <a href="/admin/events/<%= event.id %>/stalls" class="btn btn-outline">← স্টলসমূহ</a>
  </div>

  <% if (observations.length === 0) { %>
    <div class="empty-state"><p>এই স্টলে এখনো কোনো পর্যবেক্ষণ নেই।</p></div>
  <% } else { %>
    <table class="admin-table">
      <thead><tr>
        <th>সময়</th><th>ধরন</th><th>রেটিং</th><th>নোট</th><th>দ্বারা</th>
      </tr></thead>
      <tbody>
      <% observations.forEach(obs => { %>
        <tr>
          <td style="white-space:nowrap"><%= new Date(obs.created_at).toLocaleString('bn-BD') %></td>
          <td><%= obs.observation_type || '—' %></td>
          <td>
            <% if (obs.rating) { %>
              <span class="star-display">
                <% for (let i = 1; i <= 10; i++) { %><span class="<%= i <= obs.rating ? '' : 'empty' %>">★</span><% } %>
              </span>
              <span style="font-size:0.8rem;color:var(--text-muted)"> <%= obs.rating %>/১০</span>
            <% } else { %>—<% } %>
          </td>
          <td><%= obs.notes || '—' %></td>
          <td><small><%= obs.submitted_by %></small></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
