<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <h1><%- t('admin.pg_volunteers') %> — <%= event.title %></h1>
    <a href="/admin/events/<%= event.id %>/volunteers/new" class="btn btn-primary"><%- t('btn.new_volunteer') %></a>
  </div>

  <% if (volunteers.length === 0) { %>
    <div class="empty-state"><p><%- t('admin.empty_volunteers') %></p></div>
  <% } else { %>
    <table class="admin-table">
      <thead><tr>
        <th><%- t('tbl.name') %></th><th><%- t('tbl.email') %></th><th><%- t('tbl.phone') %></th><th><%- t('tbl.preference') %></th><th><%- t('tbl.remuneration') %></th><th><%- t('tbl.status') %></th><th><%- t('tbl.session') %></th><th><%- t('tbl.task') %></th><th><%- t('tbl.actions') %></th>
      </tr></thead>
      <tbody>
      <% volunteers.forEach(vol => { %>
        <tr>
          <td><%= vol.name %></td>
          <td><%= vol.email %></td>
          <td><%= vol.phone || '—' %></td>
          <td style="font-size:0.8rem">
            <% if (vol.preferred_task) { %><div><strong><%- t('tbl.task') %>:</strong> <%= vol.preferred_task %></div><% } %>
            <% if (vol.preferred_duration) { %><div><strong><%- t('tbl.session') %>:</strong> <%= vol.preferred_duration %></div><% } %>
            <% if (!vol.preferred_task && !vol.preferred_duration) { %>—<% } %>
          </td>
          <td><% if (vol.amount) { %>€<%= parseFloat(vol.amount).toFixed(2) %><% } else { %>—<% } %></td>
          <td>
            <span class="badge badge-<%= vol.status %>">
              <% if (vol.status === 'pending') { %><%- t('admin.vol_status_pending') %><% } else if (vol.status === 'approved') { %><%- t('admin.vol_status_approved') %><% } else { %><%- t('admin.vol_status_rejected') %><% } %>
            </span>
          </td>
          <td>
            <% if (vol.session_token && vol.session_expires_at) { %>
              <%
                const expiry = new Date(vol.session_expires_at);
                const now = new Date();
                const mins = Math.max(0, Math.round((expiry - now) / 60000));
                const expired = now > expiry;
              %>
              <% if (expired) { %>
                <span class="badge badge-rejected"><%- t('admin.session_expired') %></span>
              <% } else { %>
                <span class="badge badge-approved"><%= mins %> <%- t('admin.session_min') %></span>
              <% } %>
            <% } else { %>
              <span style="color:var(--text-muted);font-size:0.8rem"><%- t('admin.session_none') %></span>
            <% } %>
            <div style="margin-top:4px;display:flex;gap:4px;flex-wrap:wrap">
              <form action="/admin/volunteers/<%= vol.id %>/start-session" method="POST" style="display:inline">
                <select name="time_limit_minutes" class="inline-input" style="width:70px">
                  <option value="30">30</option>
                  <option value="60">60</option>
                  <option value="120" selected>120</option>
                  <option value="240">240</option>
                  <option value="480">480</option>
                </select>
                <button type="submit" class="btn btn-sm btn-success"><%- t('btn.start') %></button>
              </form>
              <% if (vol.session_token) { %>
                <form action="/admin/volunteers/<%= vol.id %>/stop-session" method="POST">
                  <button type="submit" class="btn btn-sm btn-danger"><%- t('btn.stop') %></button>
                </form>
              <% } %>
            </div>
          </td>
          <td>
          <%= vol.assigned_task || '—' %>
          <% if (vol.stall_id && stalls) { const _vs = stalls.find(s=>s.id===vol.stall_id); if(_vs){ %><br><small style="color:var(--text-muted)">🏪 <%= _vs.name %></small><% } } %>
        </td>
          <td class="action-cell action-cell--wrap">
            <div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:4px">
              <% if (vol.status === 'pending') { %>
                <form action="/admin/volunteers/<%= vol.id %>/approve" method="POST">
                  <button type="submit" class="btn btn-sm btn-success"><%- t('btn.approve') %></button>
                </form>
                <form action="/admin/volunteers/<%= vol.id %>/reject" method="POST">
                  <button type="submit" class="btn btn-sm btn-outline"><%- t('btn.reject') %></button>
                </form>
              <% } else { %>
                <form action="/admin/volunteers/<%= vol.id %>/pending" method="POST">
                  <button type="submit" class="btn btn-sm btn-outline"><%- t('btn.pending') %></button>
                </form>
              <% } %>
              <form action="/admin/volunteers/<%= vol.id %>/delete" method="POST" onsubmit="return confirm('স্বেচ্ছাসেবী সরাবেন?')">
                <button type="submit" class="btn btn-sm btn-danger"><%- t('btn.remove') %></button>
              </form>
            </div>
            <form action="/admin/volunteers/<%= vol.id %>/assign-task" method="POST" class="task-assign-form">
              <% if (stalls && stalls.length > 0) { %>
              <select name="stall_id" class="inline-input" style="margin-bottom:4px">
                <option value=""><%- t('vol.no_stall') %></option>
                <% stalls.forEach(s => { %><option value="<%= s.id %>" <%= vol.stall_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
              </select>
              <% } %>
              <% const hasAnyTasks = taskGroups && (taskGroups.stall.length || taskGroups.reg.length || taskGroups.qr.length || (taskGroups.music && taskGroups.music.length) || (taskGroups.competition && taskGroups.competition.length) || (taskGroups.anchor && taskGroups.anchor.length) || (taskGroups.performer && taskGroups.performer.length) || (taskGroups.controlRoom && taskGroups.controlRoom.length)); %>
              <% if (hasAnyTasks) { %>
                <select name="task" class="inline-input">
                  <option value=""><%- t('admin.select_task') %></option>
                  <% if (taskGroups.stall.length) { %>
                  <optgroup label="<%- t('admin.vt_stall') %>">
                    <% taskGroups.stall.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                  <% if (taskGroups.reg.length) { %>
                  <optgroup label="<%- t('admin.vt_reg') %>">
                    <% taskGroups.reg.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                  <% if (taskGroups.qr.length) { %>
                  <optgroup label="<%- t('admin.vt_qr') %>">
                    <% taskGroups.qr.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                  <% if (taskGroups.music && taskGroups.music.length) { %>
                  <optgroup label="<%- t('admin.vt_music') %>">
                    <% taskGroups.music.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                  <% if (taskGroups.competition && taskGroups.competition.length) { %>
                  <optgroup label="<%- t('admin.vt_competition') %>">
                    <% taskGroups.competition.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                  <% if (taskGroups.anchor && taskGroups.anchor.length) { %>
                  <optgroup label="<%- t('admin.vt_anchor') %>">
                    <% taskGroups.anchor.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                  <% if (taskGroups.performer && taskGroups.performer.length) { %>
                  <optgroup label="<%- t('admin.vt_performer') %>">
                    <% taskGroups.performer.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                  <% if (taskGroups.controlRoom && taskGroups.controlRoom.length) { %>
                  <optgroup label="<%- t('admin.vt_control_room') %>">
                    <% taskGroups.controlRoom.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                </select>
              <% } else { %>
                <input type="text" name="task" value="<%= vol.assigned_task || '' %>" placeholder="<%- t('admin.task_input_ph') %>" class="inline-input">
              <% } %>
              <button type="submit" class="btn btn-sm"><%- t('btn.assign') %></button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
