<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <h1>স্বেচ্ছাসেবী — <%= event.title %></h1>
    <a href="/admin/events/<%= event.id %>/volunteers/new" class="btn btn-primary">+ নতুন স্বেচ্ছাসেবী</a>
  </div>

  <% if (volunteers.length === 0) { %>
    <div class="empty-state"><p>এখনো কোনো স্বেচ্ছাসেবী নিবন্ধন নেই।</p></div>
  <% } else { %>
    <table class="admin-table">
      <thead><tr>
        <th>নাম</th><th>ইমেইল</th><th>ফোন</th><th>পছন্দ</th><th>পারিশ্রমিক</th><th>অবস্থা</th><th>সেশন</th><th>কাজ</th><th>কার্যক্রম</th>
      </tr></thead>
      <tbody>
      <% volunteers.forEach(vol => { %>
        <tr>
          <td><%= vol.name %></td>
          <td><%= vol.email %></td>
          <td><%= vol.phone || '—' %></td>
          <td style="font-size:0.8rem">
            <% if (vol.preferred_task) { %><div><strong>কাজ:</strong> <%= vol.preferred_task %></div><% } %>
            <% if (vol.preferred_duration) { %><div><strong>সময়কাল:</strong> <%= vol.preferred_duration %></div><% } %>
            <% if (!vol.preferred_task && !vol.preferred_duration) { %>—<% } %>
          </td>
          <td><% if (vol.amount) { %>€<%= parseFloat(vol.amount).toFixed(2) %><% } else { %>—<% } %></td>
          <td>
            <span class="badge badge-<%= vol.status %>">
              <% if (vol.status === 'pending') { %>অপেক্ষমাণ<% } else if (vol.status === 'approved') { %>অনুমোদিত<% } else { %>প্রত্যাখ্যাত<% } %>
            </span>
          </td>
          <td>
            <% if (vol.session_token && vol.session_expires_at) { %>
              <%
                const expiry = new Date(vol.session_expires_at);
                const now = new Date();
                const mins = Math.max(0, Math.round((expiry - now) / 60000));
                const expired = now > expiry;
              %>
              <% if (expired) { %>
                <span class="badge badge-rejected">মেয়াদ শেষ</span>
              <% } else { %>
                <span class="badge badge-approved"><%= mins %> মিনিট</span>
              <% } %>
            <% } else { %>
              <span style="color:var(--text-muted);font-size:0.8rem">নেই</span>
            <% } %>
            <div style="margin-top:4px;display:flex;gap:4px;flex-wrap:wrap">
              <form action="/admin/volunteers/<%= vol.id %>/start-session" method="POST" style="display:inline">
                <select name="time_limit_minutes" class="inline-input" style="width:70px">
                  <option value="30">৩০ মি</option>
                  <option value="60">১ ঘ</option>
                  <option value="120" selected>২ ঘ</option>
                  <option value="240">৪ ঘ</option>
                  <option value="480">৮ ঘ</option>
                </select>
                <button type="submit" class="btn btn-sm btn-success">শুরু</button>
              </form>
              <% if (vol.session_token) { %>
                <form action="/admin/volunteers/<%= vol.id %>/stop-session" method="POST">
                  <button type="submit" class="btn btn-sm btn-danger">বন্ধ</button>
                </form>
              <% } %>
            </div>
          </td>
          <td><%= vol.assigned_task || '—' %></td>
          <td class="action-cell action-cell--wrap">
            <div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:4px">
              <% if (vol.status === 'pending') { %>
                <form action="/admin/volunteers/<%= vol.id %>/approve" method="POST">
                  <button type="submit" class="btn btn-sm btn-success">অনুমোদন</button>
                </form>
                <form action="/admin/volunteers/<%= vol.id %>/reject" method="POST">
                  <button type="submit" class="btn btn-sm btn-outline">প্রত্যাখ্যান</button>
                </form>
              <% } else { %>
                <form action="/admin/volunteers/<%= vol.id %>/pending" method="POST">
                  <button type="submit" class="btn btn-sm btn-outline">অপেক্ষমাণ করুন</button>
                </form>
              <% } %>
              <form action="/admin/volunteers/<%= vol.id %>/delete" method="POST" onsubmit="return confirm('স্বেচ্ছাসেবী সরাবেন?')">
                <button type="submit" class="btn btn-sm btn-danger">সরান</button>
              </form>
            </div>
            <form action="/admin/volunteers/<%= vol.id %>/assign-task" method="POST" class="task-assign-form">
              <% const hasAnyTasks = taskGroups && (taskGroups.stall.length || taskGroups.reg.length || taskGroups.qr.length || (taskGroups.music && taskGroups.music.length) || (taskGroups.competition && taskGroups.competition.length)); %>
              <% if (hasAnyTasks) { %>
                <select name="task" class="inline-input">
                  <option value="">— কাজ বেছে নিন —</option>
                  <% if (taskGroups.stall.length) { %>
                  <optgroup label="স্টল পর্যবেক্ষণ">
                    <% taskGroups.stall.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                  <% if (taskGroups.reg.length) { %>
                  <optgroup label="রেজিস্ট্রেশন">
                    <% taskGroups.reg.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                  <% if (taskGroups.qr.length) { %>
                  <optgroup label="QR যাচাইকারী">
                    <% taskGroups.qr.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                  <% if (taskGroups.music && taskGroups.music.length) { %>
                  <optgroup label="সংগীত ও মঞ্চ">
                    <% taskGroups.music.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                  <% if (taskGroups.competition && taskGroups.competition.length) { %>
                  <optgroup label="প্রতিযোগিতা">
                    <% taskGroups.competition.forEach(opt => { %><option value="<%= opt %>" <%= vol.assigned_task === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </optgroup>
                  <% } %>
                </select>
              <% } else { %>
                <input type="text" name="task" value="<%= vol.assigned_task || '' %>" placeholder="কাজ নির্ধারণ..." class="inline-input">
              <% } %>
              <button type="submit" class="btn btn-sm">নির্ধারণ</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
