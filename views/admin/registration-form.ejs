<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <h1><%- t('admin.pg_add_reg') %> — <%= event.title %></h1>

  <%
    const now = new Date();
    const eventDate = new Date(event.event_date);
    let activeTier = null;
    let activeTierLabel = null;
    let activePrice = null;
    if (event.price_early_bird && event.early_bird_deadline && now <= new Date(event.early_bird_deadline)) {
      activeTier = 'early_bird'; activeTierLabel = t('event.tier_early'); activePrice = event.price_early_bird;
    } else if (event.price_mid && now <= new Date(eventDate.getTime() - 60 * 60 * 1000)) {
      activeTier = 'mid'; activeTierLabel = t('event.tier_mid'); activePrice = event.price_mid;
    } else if (event.price_onspot) {
      activeTier = 'onspot'; activeTierLabel = t('event.tier_onspot'); activePrice = event.price_onspot;
    }
  %>

  <% if (activeTier && activePrice) { %>
    <div class="ticket-price-banner" style="margin-bottom:1.5rem">
      <span class="ticket-tier-label"><%- t('admin.current_price') %> <%= activeTierLabel %></span>
      <span class="ticket-price">€<%= parseFloat(activePrice).toFixed(2) %> / adult</span>
    </div>
  <% } %>

  <form action="/admin/events/<%= event.id %>/registrations/new" method="POST" class="admin-form">
    <% if (activeTier) { %>
      <input type="hidden" name="ticket_type" value="<%= activeTier %>">
    <% } %>
    <div class="form-group">
      <label for="name"><%- t('admin.lbl_full_name') %></label>
      <input type="text" id="name" name="name" required>
    </div>
    <div class="form-group">
      <label for="email"><%- t('admin.lbl_email') %></label>
      <input type="email" id="email" name="email" placeholder="email@example.com">
      <small><%- t('admin.email_qr_hint') %></small>
    </div>
    <div class="form-group">
      <label for="phone"><%- t('admin.lbl_phone') %></label>
      <input type="tel" id="phone" name="phone" required placeholder="+49 1XX XXXXXXXX">
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="adults_count"><%- t('event.field_adults') %> (15+)</label>
        <input type="number" id="adults_count" name="adults_count" min="0" value="1" required>
      </div>
      <div class="form-group">
        <label for="children_count"><%- t('event.field_children') %> (&lt;15)</label>
        <input type="number" id="children_count" name="children_count" min="0" value="0" required>
      </div>
    </div>
    <div class="form-group">
      <label class="checkbox-label">
        <input type="checkbox" name="is_special_needs" value="true">
        বিশেষ চাহিদাপন্ন (Special needs)
      </label>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="amount"><%- t('admin.lbl_ticket_price') %></label>
        <input type="number" id="amount" name="amount" step="0.01" min="0" value="<%= activePrice || '' %>" placeholder="0.00">
        <% if (activePrice) { %>
          <small id="priceHint" style="color:var(--primary)"></small>
        <% } %>
      </div>
      <div class="form-group">
        <label for="transaction_id"><%- t('admin.lbl_transaction_id') %></label>
        <input type="text" id="transaction_id" name="transaction_id" placeholder="<%- t('admin.tbl_pay_ref') %>">
      </div>
    </div>
    <div class="form-group">
      <label for="payment_reference"><%- t('admin.lbl_pay_ref') %></label>
      <input type="text" id="payment_reference" name="payment_reference" placeholder="<%- t('admin.lbl_pay_ref_ph') %>">
    </div>
    <button type="submit" class="btn btn-primary"><%- t('admin.btn_add_reg') %></button>
    <a href="/admin/events/<%= event.id %>/registrations" class="btn btn-outline"><%- t('btn.cancel') %></a>
  </form>
  <% if (activePrice) { %>
  <script>
  (function() {
    var pricePerAdult = <%= parseFloat(activePrice) %>;
    var adultsInput = document.getElementById('adults_count');
    var amountInput = document.getElementById('amount');
    var hint = document.getElementById('priceHint');
    function update() {
      var a = parseInt(adultsInput.value) || 0;
      var total = (a * pricePerAdult).toFixed(2);
      amountInput.value = total;
      hint.textContent = a + ' × €' + pricePerAdult.toFixed(2) + ' = €' + total;
    }
    adultsInput.addEventListener('input', update);
    update();
  })();
  </script>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
