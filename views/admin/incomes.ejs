<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>
<% var _dateLocale = locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-GB' : 'bn-BD'; %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <div class="section-header">
    <h1><%- t('admin.pg_incomes') %> — <%= event.title %></h1>
    <a href="/admin/events/<%= event.id %>/incomes/new" class="btn btn-primary"><%- t('btn.add_income') %></a>
  </div>

  <div class="total-banner"><%- t('admin.total_income') %> <strong>€<%= total.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) %></strong></div>

  <% if (incomes.length === 0) { %>
    <div class="empty-state"><p><%- t('admin.empty_incomes') %></p></div>
  <% } else { %>
    <table class="admin-table">
      <thead><tr>
        <th><%- t('tbl.category') %></th><th><%- t('tbl.description') %></th><th><%- t('tbl.amount') %></th><th><%- t('tbl.transaction_id') %></th><th><%- t('tbl.payer') %></th><th><%- t('tbl.payment_date') %></th><th><%- t('tbl.actions') %></th>
      </tr></thead>
      <tbody>
      <% incomes.forEach(inc => { %>
        <tr>
          <td><%= inc.category || '—' %></td>
          <td><%= inc.description || '—' %></td>
          <td>€<%= parseFloat(inc.amount).toLocaleString('en-US', {minimumFractionDigits:2}) %></td>
          <td><% if (inc.transaction_id) { %><code><%= inc.transaction_id %></code><% } else { %>—<% } %></td>
          <td>
            <% if (inc.payer_name) { %><%= inc.payer_name %><% } %>
            <% if (inc.payer_email) { %><br><small><%= inc.payer_email %></small><% } %>
            <% if (!inc.payer_name && !inc.payer_email) { %>—<% } %>
          </td>
          <td style="white-space:nowrap;font-size:0.85rem">
            <% if (inc.payment_date) { %>
              <%= new Date(inc.payment_date).toLocaleDateString(_dateLocale, { timeZone: 'Europe/Berlin' }) %><br>
              <span style="color:var(--text-muted)"><%= new Date(inc.payment_date).toLocaleTimeString(_dateLocale, { timeZone: 'Europe/Berlin', hour: '2-digit', minute: '2-digit' }) %></span>
            <% } else { %>
              <%= new Date(inc.created_at).toLocaleDateString(_dateLocale, { timeZone: 'Europe/Berlin' }) %>
            <% } %>
          </td>
          <td>
            <form action="/admin/incomes/<%= inc.id %>/delete" method="POST" onsubmit="return confirm('এই আয় মুছে ফেলবেন?')">
              <button type="submit" class="btn btn-sm btn-danger"><%- t('btn.delete') %></button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
