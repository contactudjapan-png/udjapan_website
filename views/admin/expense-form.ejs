<%- include('../partials/head') %>
<body class="admin-page">
<%- include('../partials/nav-admin') %>
<%- include('../partials/flash') %>

<main class="admin-container">
  <%- include('../partials/event-subnav') %>
  <h1>খরচ যোগ করুন — <%= event.title %></h1>

  <form action="/admin/events/<%= event.id %>/expenses/new" method="POST" enctype="multipart/form-data" class="admin-form">
    <% if (categories && categories.length > 0) { %>
    <div class="form-group">
      <label for="category">ক্যাটাগরি</label>
      <select id="category" name="category">
        <option value="">— ক্যাটাগরি বাছুন —</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat %>"><%= cat %></option>
        <% }) %>
      </select>
    </div>
    <% } %>
    <div class="form-group">
      <label for="description">বিবরণ *</label>
      <input type="text" id="description" name="description" required placeholder="যেমন: ভেন্যু ভাড়া">
    </div>
    <div class="form-group">
      <label for="amount">পরিমাণ (€) *</label>
      <input type="number" id="amount" name="amount" required min="0" step="0.01" placeholder="0.00">
    </div>
    <div class="form-group">
      <label for="receipt">রসিদের ছবি (ঐচ্ছিক)</label>
      <input type="file" id="receipt" name="receipt" accept="image/*">
    </div>
    <button type="submit" class="btn btn-primary">খরচ যোগ করুন</button>
    <a href="/admin/events/<%= event.id %>/expenses" class="btn btn-outline">বাতিল</a>
  </form>
</main>

<%- include('../partials/footer') %>
</body>
</html>
