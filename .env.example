PORT=3000
BASE_URL=http://localhost:3000

# Set to true to use in-memory DB (no Supabase needed for local testing)
USE_MEMORY_DB=true

# Admin credentials for in-memory mode
ADMIN_EMAIL=admin@udjapon.com
ADMIN_PASSWORD=admin

# Supabase (only needed when USE_MEMORY_DB=false)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# SMTP Email (optional — confirmation emails will be skipped if not set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-password
EMAIL_FROM=UDJapon <your@email.com>
